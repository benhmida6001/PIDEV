<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #4caf50;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controllers.RechercherEvenementsParCritereController">
   <children>
      <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Rechercher  Événements par Critère" />
      
      <Separator style="-fx-background-color: white;" />
      
      <VBox spacing="15.0" style="-fx-background-color: #f1f8e9; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #4CAF50; -fx-border-radius: 10; -fx-border-width: 2;">
         <children>
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Label prefWidth="120.0" text="Critère de recherche :" />
                  <TextField fx:id="critereField" prefWidth="250.0" promptText="Entrez un mot-clé (nom, lieu, description)" />
                  <Button fx:id="rechercherButton" onAction="#handleRechercher" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Rechercher" />
                  <Button onAction="#handleVider" prefWidth="80.0" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold;" text="Vider" />
               </children>
            </HBox>
            
            <Label fx:id="messageLabel" style="-fx-text-fill: red;" text="" />
         </children>
      </VBox>
      
      <TableView fx:id="resultatsTable" prefHeight="300.0" prefWidth="700.0" style="-fx-background-color: white; -fx-border-color: #4CAF50; -fx-border-width: 1;">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="nomColumn" prefWidth="150.0" text="Nom" />
            <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
            <TableColumn fx:id="lieuColumn" prefWidth="120.0" text="Lieu" />
            <TableColumn fx:id="capaciteColumn" prefWidth="80.0" text="Capacité" />
            <TableColumn fx:id="pointsColumn" prefWidth="80.0" text="Points" />
         </columns>
      </TableView>
      
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#handleDetails" prefWidth="100.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Détails" />
            <Button onAction="#handleRetour" prefWidth="80.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" text="Retour" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
