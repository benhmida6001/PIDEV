<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #4caf50;" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controllers.MettreAJourPointsController">
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Mettre à jour les points" />
      
      <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="80.0" text="ID Utilisateur :" />
                  <TextField fx:id="idField" prefWidth="200.0" promptText="ID de l'utilisateur" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="80.0" text="Points :" />
                  <TextField fx:id="pointsField" prefWidth="200.0" promptText="Nouveaux points" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#handleMettreAJour" prefWidth="120.0" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold;" text="Mettre à jour" />
            <Button onAction="#handleAnnuler" prefWidth="100.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="Annuler" />
         </children>
      </HBox>
      
      <Label fx:id="messageLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
