<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #4caf50;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controllers.SupprimerUtilisateurController">
   <children>
      <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Confirmer la suppression" textFill="WHITE" />
      <Label fx:id="messageLabel" maxWidth="400.0" wrapText="true" />
      <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f1f8e9; -fx-padding: 15; -fx-background-radius: 10;">
         <children>
            <Button onAction="#handleConfirmer" prefWidth="120.0" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="Supprimer" />
            <Button onAction="#handleAnnuler" prefWidth="120.0" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold;" text="Annuler" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
</VBox>
