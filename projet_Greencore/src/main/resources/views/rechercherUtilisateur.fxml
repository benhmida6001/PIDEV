<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: #4caf50;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controllers.RechercherUtilisateurController">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Rechercher utilisateur " />
      <Separator />
      <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f1f8e9; -fx-padding: 10; -fx-background-radius: 8;">
         <children>
            <Label text="ID :" />
            <TextField fx:id="idField" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #4CAF50; -fx-border-width: 1;" />
            <Button onAction="#handleRechercher" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Rechercher" />
         </children>
      </HBox>
      <TableView fx:id="resultatsTable" prefHeight="280.0" prefWidth="720.0" style="-fx-background-color: white; -fx-border-color: #4CAF50; -fx-border-width: 1;">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="nomColumn" prefWidth="120.0" text="Nom" />
            <TableColumn fx:id="prenomColumn" prefWidth="120.0" text="Prénom" />
            <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
            <TableColumn fx:id="telephoneColumn" prefWidth="100.0" text="Téléphone" />
            <TableColumn fx:id="roleColumn" prefWidth="80.0" text="Rôle" />
            <TableColumn fx:id="pointsColumn" prefWidth="60.0" text="Points" />
         </columns>
      </TableView>
      <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f1f8e9; -fx-padding: 10; -fx-background-radius: 8;">
         <children>
            <Button onAction="#handleMettreAJourPoints" prefWidth="140.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Mettre à jour Points" />
            <Button onAction="#handleFermer" prefWidth="100.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="Fermer" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
</VBox>
