<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #4caf50;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controllers.AjouterEvenementController">
   <children>
      <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Ajouter Événement" />
      
      <Separator style="-fx-background-color: white;" />
      
      <VBox spacing="15.0" style="-fx-background-color: #f1f8e9; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #4CAF50; -fx-border-radius: 10; -fx-border-width: 2;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Nom de l'événement :" />
                  <TextField fx:id="nomField" prefWidth="300.0" promptText="Nom de l'événement" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Date et heure :" />
                  <TextField fx:id="dateField" prefWidth="300.0" promptText="AAAA-MM-JJ HH:MM" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Lieu :" />
                  <TextField fx:id="lieuField" prefWidth="300.0" promptText="Lieu de l'événement" />
               </children>
            </HBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Description :" />
                  <TextArea fx:id="descriptionArea" prefHeight="100.0" prefWidth="400.0" promptText="Description" wrapText="true" />
               </children>
            </VBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Capacité maximale :" />
                  <TextField fx:id="capaciteField" prefWidth="150.0" promptText="Nombre de participants" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="120.0" text="Points offerts :" />
                  <TextField fx:id="pointsField" prefWidth="150.0" promptText="Points pour participation" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#handleAjouter" prefWidth="120.0" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold;" text="Ajouter" />
            <Button onAction="#handleAnnuler" prefWidth="100.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="Annuler" />
            <Button onAction="#handleRetour" prefWidth="80.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" text="Retour" />
         </children>
      </HBox>
      
      <Label fx:id="messageLabel" style="-fx-text-fill: red;" text="" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
