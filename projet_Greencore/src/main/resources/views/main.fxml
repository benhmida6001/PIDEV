<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="422.0" prefWidth="593.0" spacing="20" style="-fx-background-color: #4caf50;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controllers.MainController">
   <children>
      
      <HBox alignment="CENTER" spacing="15">
         <children>
            <ImageView fitHeight="207.0" fitWidth="370.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Logo%20de%20GreenCore%20avec%20globe%20détaillé.png" />
               </image>
            </ImageView>
         </children></HBox>
      <AnchorPane prefHeight="388.0" prefWidth="554.0" style="-fx-background-color: #4caf50;">
         <children>
            <Button layoutX="24.0" layoutY="154.0" onAction="#handleGestionUtilisateurs" prefHeight="26.0" prefWidth="161.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="Gestion des Utilisateurs" textFill="WHITE" />
            <Button layoutX="201.0" layoutY="154.0" onAction="#handleRechercherUtilisateur" prefHeight="26.0" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Rechercher Utilisateur" />
            <Label fx:id="welcomeLabel" layoutX="217.0" layoutY="38.0" prefHeight="55.0" prefWidth="136.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Bienvenue" />
            <Button layoutX="370.0" layoutY="154.0" onAction="#handleDeconnexion" prefWidth="150.0" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold;" text="Déconnexion" />
            <Button layoutX="24.0" layoutY="193.0" onAction="#handleGestionEvenements" prefHeight="26.0" prefWidth="161.0" style="-fx-background-color: #7B1FA2; -fx-text-fill: white; -fx-font-weight: bold;" text="Gestion des Événements" />
         </children>
      </AnchorPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
