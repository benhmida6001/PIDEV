<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MapDialogController">
   <children>
      <VBox layoutX="0.0" layoutY="0.0" prefHeight="700.0" prefWidth="900.0">
         <children>
            <!-- Header -->
            <AnchorPane prefHeight="60.0" prefWidth="900.0" style="-fx-background-color: #4caf50;">
               <children>
                  <Label layoutX="20.0" layoutY="15.0" text="Sélectionner un lieu" textFill="WHITE">
                     <font>
                        <Font name="Cambria Bold" size="24.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnClose" layoutX="820.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="✕">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </AnchorPane>
            
            <!-- Address Input Section -->
            <AnchorPane prefHeight="80.0" prefWidth="900.0" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label layoutX="20.0" layoutY="10.0" text="Adresse recherchée:" textFill="#333333">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnSearch" layoutX="750.0" layoutY="35.0" mnemonicParsing="false" onAction="#handleSearch" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #2196f3; -fx-text-fill: white;" text=" Rechercher">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnUseAddress" layoutX="610.0" layoutY="35.0" mnemonicParsing="false" onAction="#handleUseAddress" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text=" Utiliser">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <TextField fx:id="tfAddress" layoutX="20.0" layoutY="35.0" prefHeight="30.0" prefWidth="580.0" promptText="Entrez une adresse complète..." />
               </children>
            </AnchorPane>
            
            <!-- WebView for Maps -->
            <AnchorPane prefHeight="520.0" prefWidth="900.0" style="-fx-background-color: #ffffff;">
               <children>
                  <WebView fx:id="webView" layoutX="0.0" layoutY="0.0" prefHeight="520.0" prefWidth="900.0" />
               </children>
            </AnchorPane>
            
            <!-- Footer with Instructions -->
            <AnchorPane prefHeight="40.0" prefWidth="900.0" style="-fx-background-color: #e3f2fd; -fx-border-color: #bbdefb; -fx-border-width: 1 0 0 0;">
               <children>
                  <Label layoutX="20.0" layoutY="10.0" text="💡 Conseil: Entrez une adresse complète (numéro, rue, ville) pour une meilleure localisation" textFill="#1976d2">
                     <font>
                        <Font name="System" size="12.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
