<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="717.0" prefWidth="1378.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PaymentController">
    <children>

        <!-- Header -->
        <AnchorPane layoutX="0" layoutY="0" prefHeight="70" prefWidth="1385.0" style="-fx-background-color: #2e7d32;">
            <children>
                <Label layoutX="24" layoutY="14" style="-fx-text-fill: white;" text="Paiements — GreenCore">
                    <Font name="Cambria Bold Italic" size="26" />
                </Label>
                <Label layoutX="24" layoutY="46" style="-fx-text-fill: #a5d6a7; -fx-font-size: 12;" text="Intégration Stripe — Paiements sécurisés" />

                <!-- Stats rapides -->
                <Label fx:id="labelTotalTx" layoutX="900" layoutY="14" style="-fx-text-fill: white; -fx-font-size: 13;" text="Transactions : 0" />
                <Label fx:id="labelTotalMontant" layoutX="900" layoutY="38" style="-fx-text-fill: #a5d6a7; -fx-font-size: 13;" text="Total : 0.00 €" />
            </children>
        </AnchorPane>

        <!-- Formulaire paiement -->
        <AnchorPane layoutX="0" layoutY="70" prefHeight="633" prefWidth="660" style="-fx-background-color: white;                            -fx-border-color: #e0e0e0;                            -fx-border-width: 0 1 0 0;">
            <children>

                <Label layoutX="24" layoutY="24" style="-fx-font-size: 18; -fx-text-fill: #2e7d32;" text="Nouveau Paiement">
                    <Font name="Cambria Bold Italic" size="18" />
                </Label>

                <!-- Utilisateur -->
                <Label layoutX="24" layoutY="72" style="-fx-font-size: 14; -fx-text-fill: #333;" text="Utilisateur :" />
                <ComboBox fx:id="comboUtilisateur" layoutX="24" layoutY="96" prefHeight="36" prefWidth="600" promptText="Sélectionnez un utilisateur..." />

                <!-- Événement -->
                <Label layoutX="24" layoutY="150" style="-fx-font-size: 14; -fx-text-fill: #333;" text="Événement :" />
                <ComboBox fx:id="comboEvenement" layoutX="24" layoutY="174" prefHeight="36" prefWidth="600" promptText="Sélectionnez un événement..." />

                <!-- Montant -->
                <Label layoutX="24" layoutY="228" style="-fx-font-size: 14; -fx-text-fill: #333;" text="Montant (€) :" />
                <TextField fx:id="txtMontant" layoutX="24" layoutY="252" prefHeight="36" prefWidth="280" promptText="ex: 50.00" style="-fx-border-color: #c8e6c9; -fx-border-radius: 4;                                   -fx-font-size: 16;" />
                <Label layoutX="316" layoutY="262" style="-fx-font-size: 14; -fx-text-fill: #888;" text="EUR" />

                <!-- Résumé avant paiement -->
                <AnchorPane layoutX="24" layoutY="308" prefHeight="140" prefWidth="600" style="-fx-background-color: #e8f5e9;                                    -fx-border-color: #c8e6c9; -fx-border-radius: 8;                                    -fx-background-radius: 8; -fx-padding: 12;">
                    <children>
                        <Label layoutX="12" layoutY="10" style="-fx-font-size: 13; -fx-font-weight: bold;                                       -fx-text-fill: #2e7d32;" text="Résumé" />
                        <Label fx:id="labelResumeUser" layoutX="12" layoutY="34" style="-fx-font-size: 13; -fx-text-fill: #333;" text="Utilisateur : --" />
                        <Label fx:id="labelResumeEvent" layoutX="12" layoutY="58" style="-fx-font-size: 13; -fx-text-fill: #333;" text="Événement : --" />
                        <Label fx:id="labelResumeMontant" layoutX="12" layoutY="82" style="-fx-font-size: 16; -fx-font-weight: bold;                                       -fx-text-fill: #1b5e20;" text="Montant : -- €" />
                        <Label fx:id="labelResumePoints" layoutX="12" layoutY="108" style="-fx-font-size: 12; -fx-text-fill: #4caf50;" text="Points gagnés : --" />
                    </children>
                </AnchorPane>

                <!-- Bouton payer -->
                <Button fx:id="btnPayer" layoutX="24" layoutY="468" onAction="#handlePayer" prefHeight="50" prefWidth="600" style="-fx-background-color: #2e7d32;                                -fx-text-fill: white; -fx-cursor: hand;                                -fx-font-size: 18; -fx-font-weight: bold;                                -fx-border-radius: 8; -fx-background-radius: 8;" text="Payer via Stripe" />

                <!-- Résultat -->
                <Label fx:id="labelResultatPaiement" layoutX="24" layoutY="530" prefWidth="600" style="-fx-font-size: 13; -fx-text-fill: #4caf50;" text="" wrapText="true" />

                <!-- Remboursement -->
                <Label layoutX="24" layoutY="570" style="-fx-font-size: 13; -fx-text-fill: #555;" text="Remboursement — Transaction ID :" />
                <TextField fx:id="txtTransactionId" layoutX="24" layoutY="592" prefHeight="32" prefWidth="440" promptText="pi_xxxxxxxxxxxx" style="-fx-border-color: #ffccbc; -fx-border-radius: 4;" />
                <Button fx:id="btnRembourser" layoutX="476" layoutY="592" onAction="#handleRembourser" prefHeight="32" prefWidth="148" style="-fx-background-color: #e53935;                                -fx-text-fill: white; -fx-cursor: hand;" text="Rembourser" />
            </children>
        </AnchorPane>

        <!-- Historique paiements -->
        <AnchorPane layoutX="660" layoutY="70" prefHeight="647.0" prefWidth="672.0" style="-fx-background-color: #f5f5f5; -fx-padding: 16;">
            <children>
                <Label layoutX="16" layoutY="16" style="-fx-font-size: 18; -fx-text-fill: #2e7d32;" text="Historique des paiements">
                    <Font name="Cambria Bold Italic" size="18" />
                </Label>

                <ComboBox fx:id="comboUtilisateurHistorique" layoutX="16" layoutY="52" prefHeight="32" prefWidth="360" promptText="Filtrer par utilisateur..." />

                <Button fx:id="btnVoirHistorique" layoutX="383.0" layoutY="52.0" onAction="#handleVoirHistorique" prefHeight="32" prefWidth="140" style="-fx-background-color: #4caf50;                                -fx-text-fill: white; -fx-cursor: hand;" text="Voir historique" />

                <Button fx:id="btnStats" layoutX="533.0" layoutY="52.0" onAction="#handleStats" prefHeight="32" prefWidth="140.0" style="-fx-background-color: #2e7d32;                                -fx-text-fill: white; -fx-cursor: hand;" text="Statistiques" />

                <TableView fx:id="tableHistorique" layoutX="14.0" layoutY="95.0" prefHeight="520" prefWidth="678.0">
                    <columns>
                        <TableColumn fx:id="colTransaction" prefWidth="168.0" text="Transaction ID" />
                        <TableColumn fx:id="colMontant" prefWidth="132.0" text="Montant" />
                        <TableColumn fx:id="colDevise" prefWidth="70" text="Devise" />
                        <TableColumn fx:id="colDate" prefWidth="96.0" text="Date" />
                        <TableColumn fx:id="colStatut" prefWidth="99.9998779296875" text="Statut" />
                        <TableColumn fx:id="colActions" prefWidth="124.800048828125" text="Actions" />
                    </columns>
                </TableView>
            </children>
        </AnchorPane>

    </children>
</AnchorPane>
