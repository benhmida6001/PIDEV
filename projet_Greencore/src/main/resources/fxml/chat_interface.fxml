<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="704.0" prefWidth="1348.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ChatController">
    <children>

        <!-- Sidebar utilisateurs -->
        <AnchorPane layoutX="0" layoutY="0" prefHeight="703" prefWidth="212.0" style="-fx-background-color: #2e7d32;">
            <children>
                <Label layoutX="16" layoutY="16" style="-fx-text-fill: white;" text="Chat Greencore">
                    <Font name="Cambria Bold Italic" size="20" />
                </Label>

                <Label layoutX="16" layoutY="56" style="-fx-text-fill: #a5d6a7; -fx-font-size: 12;" text="Utilisateurs en ligne" />

                <ListView fx:id="listUsers" layoutX="0" layoutY="76" prefHeight="560" prefWidth="209.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" />

                <Button fx:id="btnActualiser" layoutX="-3.0" layoutY="657.0" onAction="#handleActualiser" prefHeight="32" prefWidth="210.0" style="-fx-background-color: #1b5e20; -fx-text-fill: white;                                -fx-cursor: hand; -fx-font-size: 13;" text="Actualiser utilisateurs" />
            </children>
        </AnchorPane>

        <!-- Zone principale chat -->
        <AnchorPane layoutX="280" layoutY="0" prefHeight="706.0" prefWidth="1078.0" style="-fx-background-color: #f5f5f5;">
            <children>

                <!-- Header -->
                <AnchorPane layoutX="-68.0" prefHeight="60" prefWidth="1025.0" style="-fx-background-color: white;                                    -fx-border-color: #e0e0e0;                                    -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label fx:id="labelConversation" layoutX="20" layoutY="10" style="-fx-font-size: 16; -fx-text-fill: #2e7d32;" text="Sélectionnez un utilisateur">
                            <Font name="Cambria Bold Italic" size="16" />
                        </Label>
                        <Label fx:id="labelStatut" layoutX="20" layoutY="34" style="-fx-font-size: 12; -fx-text-fill: #888;" text="" />

                        <!-- Bouton résumé IA -->
                        <Button fx:id="btnResumeIA" layoutX="798.0" layoutY="18.0" onAction="#handleResumeIA" prefHeight="32" prefWidth="200" style="-fx-background-color: #4caf50; -fx-text-fill: white;                                        -fx-cursor: hand; -fx-font-size: 12;" text="Résumé IA des événements" />
                    </children>
                </AnchorPane>

                <!-- Messages -->
                <ScrollPane fx:id="scrollMessages" fitToWidth="true" layoutX="0" layoutY="60" prefHeight="530" prefWidth="958.0" style="-fx-background-color: #f5f5f5;                                    -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="vboxMessages" spacing="8" style="-fx-padding: 16; -fx-background-color: #f5f5f5;">
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Zone saisie -->
                <AnchorPane layoutX="0" layoutY="590" prefHeight="114.0" prefWidth="958.0" style="-fx-background-color: white;                                    -fx-border-color: #e0e0e0;                                    -fx-border-width: 1 0 0 0;">
                    <children>
                        <TextArea fx:id="txtMessage" layoutX="16" layoutY="12" prefHeight="80" prefWidth="802.0" promptText="Tapez votre message..." style="-fx-border-color: #c8e6c9;                                          -fx-border-radius: 6;                                          -fx-background-radius: 6;                                          -fx-font-size: 13;" wrapText="true" />

                        <Button fx:id="btnEnvoyer" layoutX="821.0" layoutY="12.0" onAction="#handleEnvoyer" prefHeight="38" prefWidth="130" style="-fx-background-color: #2e7d32;                                        -fx-text-fill: white; -fx-cursor: hand;                                        -fx-font-size: 14; -fx-font-weight: bold;" text="Envoyer" />

                        <Button fx:id="btnEffacer" layoutX="821.0" layoutY="57.0" onAction="#handleEffacer" prefHeight="32" prefWidth="130" style="-fx-background-color: #e0e0e0;                                        -fx-text-fill: #555; -fx-cursor: hand;                                        -fx-font-size: 13;" text="Effacer" />
                    </children>
                </AnchorPane>

                <!-- Zone résumé IA (cachée par défaut) -->
                <AnchorPane fx:id="paneResume" layoutX="0" layoutY="60" prefHeight="530" prefWidth="1114" style="-fx-background-color: white; -fx-padding: 20;" visible="false">
                    <children>
                        <Label layoutX="20" layoutY="16" style="-fx-font-size: 18; -fx-text-fill: #2e7d32;" text="Résumé IA des événements Greencore">
                            <Font name="Cambria Bold Italic" size="18" />
                        </Label>

                        <TextArea fx:id="txtResume" editable="false" layoutX="20" layoutY="50" prefHeight="420" prefWidth="1060" promptText="Le résumé IA apparaîtra ici..." style="-fx-font-size: 14; -fx-border-color: #c8e6c9;                                          -fx-border-radius: 6;" wrapText="true" />

                        <Button layoutX="20" layoutY="488" onAction="#handleFermerResume" style="-fx-background-color: #e0e0e0;                                        -fx-text-fill: #555; -fx-cursor: hand;" text="Fermer" />

                        <Label fx:id="labelChargement" layoutX="120" layoutY="492" style="-fx-text-fill: #4caf50; -fx-font-size: 13;" text="" />
                    </children>
                </AnchorPane>

            </children>
        </AnchorPane>
    </children>
</AnchorPane>
