<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controller.MaterielFormController">
   <center>
      <VBox alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #2ecc71, #27ae60); -fx-padding: 40;">
         <children>
            <Label text="Formulaire Matériel" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="24" />
               </font>
            </Label>
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10;">
               <children>
                  <Label text="Nom du matériel" style="-fx-font-size: 14px; -fx-font-weight: bold;">
                     <VBox.margin>
                        <Insets bottom="5" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="nameField" promptText="Entrez le nom du matériel" style="-fx-pref-width: 400;">
                     <VBox.margin>
                        <Insets bottom="15" />
                     </VBox.margin>
                  </TextField>
                  
                  <Label text="Description" style="-fx-font-size: 14px; -fx-font-weight: bold;">
                     <VBox.margin>
                        <Insets bottom="5" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="descriptionField" promptText="Entrez la description" style="-fx-pref-width: 400;">
                     <VBox.margin>
                        <Insets bottom="15" />
                     </VBox.margin>
                  </TextField>
                  
                  <Label text="Quantité" style="-fx-font-size: 14px; -fx-font-weight: bold;">
                     <VBox.margin>
                        <Insets bottom="5" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="quantityField" promptText="Entrez la quantité" style="-fx-pref-width: 400;">
                     <VBox.margin>
                        <Insets bottom="15" />
                     </VBox.margin>
                  </TextField>
                  
                  <Label fx:id="errorLabel" visible="false" wrapText="true" style="-fx-pref-width: 400; -fx-text-fill: red;">
                     <VBox.margin>
                        <Insets bottom="10" />
                     </VBox.margin>
                  </Label>
                  
                  <Button fx:id="saveButton" onAction="#handleSave" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 400; -fx-pref-height: 40;" text="Enregistrer">
                     <VBox.margin>
                        <Insets bottom="10" />
                     </VBox.margin>
                  </Button>
                  
                  <Button fx:id="cancelButton" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-border-color: #e74c3c; -fx-border-radius: 5; -fx-pref-width: 400; -fx-pref-height: 40;" text="Annuler" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
