<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controller.DashboardController">
   <top>
      <VBox style="-fx-background-color: #2c3e50; -fx-padding: 10;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20">
               <children>
                  <Label fx:id="welcomeLabel" text="Bienvenue" textFill="WHITE">
                     <font>
                        <Font name="Arial Bold" size="18" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchField" promptText="Rechercher un matériel..." prefWidth="300" />
                  <Button text="Rafraîchir" onAction="#loadMateriels" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <left>
      <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 20; -fx-pref-width: 200;">
         <children>
            <Label text="Navigation" style="-fx-font-size: 16px; -fx-font-weight: bold;">
               <VBox.margin>
                  <Insets bottom="20" />
               </VBox.margin>
            </Label>
            <Button fx:id="addButton" text="Ajouter Matériel" onAction="#handleNewMateriel" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-pref-width: 180;" />
            <Button fx:id="editButton" text="Modifier" onAction="#handleEditMateriel" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-pref-width: 180;" />
            <Button fx:id="borrowButton" text="Emprunter" onAction="#handleRequestBorrow" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-pref-width: 180;" />
            <Button fx:id="refreshButton" text="Actualiser" onAction="#loadMateriels" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-pref-width: 180;" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox style="-fx-padding: 20;">
         <children>
            <Label text="Liste des Matériels Disponibles" style="-fx-font-size: 18px; -fx-font-weight: bold;">
               <VBox.margin>
                  <Insets bottom="10" />
               </VBox.margin>
            </Label>
            <TableView fx:id="materielTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="nameColumn" text="Nom" prefWidth="200" />
                  <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="150" />
                  <TableColumn fx:id="quantityColumn" text="Quantité" prefWidth="100" />
                  <TableColumn fx:id="availableColumn" text="Disponible" prefWidth="100" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
