<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controller.RegisterController">
   <center>
      <VBox alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9); -fx-padding: 40;">
         <children>
            <Label text="CRÉER UN COMPTE" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="28" />
               </font>
            </Label>
            <Label text="Rejoignez la communauté GREENCORE" textFill="WHITE">
               <font>
                  <Font size="14" />
               </font>
            </Label>
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10;">
               <children>
                  <TextField fx:id="nameField" promptText="Nom complet" style="-fx-pref-width: 280;" />
                  <TextField fx:id="emailField" promptText="Email" style="-fx-pref-width: 280;" />
                  <PasswordField fx:id="passwordField" promptText="Mot de passe" style="-fx-pref-width: 280;" />
                  <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe" style="-fx-pref-width: 280;" />
                  <Label fx:id="errorLabel" visible="false" wrapText="true" style="-fx-pref-width: 280; -fx-text-fill: red;">
                     <VBox.margin>
                        <Insets top="5" />
                     </VBox.margin>
                  </Label>
                  <Button fx:id="registerButton" onAction="#handleRegister" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 280; -fx-pref-height: 45;" text="Créer mon compte">
                     <VBox.margin>
                        <Insets top="10" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="cancelButton" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-pref-width: 280; -fx-pref-height: 40;" text="Annuler" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
