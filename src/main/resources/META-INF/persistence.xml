<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    
    <persistence-unit name="greencore-pu">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>com.greencore.model.entity.User</class>
        <class>com.greencore.model.entity.Category</class>
        <class>com.greencore.model.entity.Materiel</class>
        <class>com.greencore.model.entity.Operation</class>
        <class>com.greencore.model.entity.OperationType</class>
        <class>com.greencore.model.entity.OperationStatus</class>
        <class>com.greencore.model.entity.Status</class>
        
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://127.0.0.1:3306/pidev_greencore?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
        </properties>
    </persistence-unit>
    
</persistence>
