<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controller.ProfileController" spacing="20" style="-fx-background-color: #F5F5F5; -fx-padding: 40;">
    
    <!-- Profile Header -->
    <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <!-- Avatar -->
        <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="avatarImageView" fitWidth="100" fitHeight="100" preserveRatio="true">
                <clip>
                    <Circle centerX="50" centerY="50" radius="50"/>
                </clip>
            </ImageView>
            <Button fx:id="changeAvatarButton" text="Change Photo" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand;"/>
        </VBox>
        
        <!-- User Info -->
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <Label fx:id="nameLabel" text="User Name" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
            <Label fx:id="emailLabel" text="user@example.com" style="-fx-font-size: 16px; -fx-text-fill: #666666;"/>
            
            <!-- Role Badges -->
            <HBox spacing="10">
                <Label fx:id="userRoleBadge" text="USER" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 6 12; -fx-font-size: 12px;"/>
                <Label fx:id="memberSinceLabel" text="Member since 2024" style="-fx-background-color: #E0E0E0; -fx-text-fill: #666666; -fx-background-radius: 12; -fx-padding: 6 12; -fx-font-size: 12px;"/>
            </HBox>
            
            <!-- Action Buttons -->
            <HBox spacing="10">
                <Button fx:id="editProfileButton" text="Edit Profile" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button fx:id="changePasswordButton" text="Change Password" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;"/>
            </HBox>
        </VBox>
    </HBox>
    
    <!-- Stats Section -->
    <HBox spacing="20" alignment="CENTER">
        <!-- Stats Card 1 -->
        <VBox spacing="5" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-pref-width: 150;">
            <Label fx:id="totalMaterielsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
            <Label text="Total Items" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
        </VBox>
        
        <!-- Stats Card 2 -->
        <VBox spacing="5" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-pref-width: 150;">
            <Label fx:id="sharedMaterielsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
            <Label text="Shared" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
        </VBox>
        
        <!-- Stats Card 3 -->
        <VBox spacing="5" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-pref-width: 150;">
            <Label fx:id="borrowedMaterielsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
            <Label text="Borrowed" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
        </VBox>
        
        <!-- Stats Card 4 -->
        <VBox spacing="5" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-pref-width: 150;">
            <Label fx:id="pendingRequestsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
            <Label text="Pending Requests" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
        </VBox>
    </HBox>
    
    <!-- Account Settings -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Account Settings" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
        
        <GridPane hgap="15" vgap="15">
            <Label text="Email:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="emailTextField" promptText="Enter email" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-pref-width: 300;"/>
            
            <Label text="Current Password:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <PasswordField fx:id="currentPasswordField" promptText="Enter current password" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-pref-width: 300;"/>
            
            <Label text="New Password:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <PasswordField fx:id="newPasswordField" promptText="Enter new password" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-pref-width: 300;"/>
            
            <Label text="Confirm Password:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-pref-width: 300;"/>
        </GridPane>
        
        <HBox spacing="10">
            <Button fx:id="saveProfileButton" text="Save Profile" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 20;"/>
            <Button fx:id="cancelButton" text="Cancel" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 20;"/>
        </HBox>
    </VBox>
    
    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>
</VBox>
