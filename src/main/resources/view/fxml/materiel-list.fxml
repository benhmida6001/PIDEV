<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controller.MaterielController" spacing="10" style="-fx-background-color: #F5F5F5; -fx-padding: 20;">
    
    <!-- Header -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
        <Label text="Gestion des Matériels" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Rechercher..." style="-fx-pref-width: 250; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 12;"/>
        <Button fx:id="refreshButton" text="🔄" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 20; -fx-pref-width: 40; -fx-pref-height: 40;"/>
        <Button fx:id="backButton" text="← Retour" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15;"/>
    </HBox>
    
    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="addButton" text="➕ Ajouter" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 20; -fx-font-weight: bold;"/>
        <Button fx:id="editButton" text="✏️ Modifier" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 20; -fx-font-weight: bold;" disable="true"/>
        <Button fx:id="deleteButton" text="🗑️ Supprimer" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 20; -fx-font-weight: bold;" disable="true"/>
    </HBox>
    
    <!-- TableView -->
    <TableView fx:id="materielTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
        <columns>
            <TableColumn fx:id="nameColumn" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200"/>
            <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="120"/>
            <TableColumn fx:id="quantityColumn" text="Quantité" prefWidth="80"/>
            <TableColumn fx:id="availableColumn" text="Disponible" prefWidth="80"/>
            <TableColumn fx:id="statusColumn" text="État" prefWidth="100"/>
            <TableColumn fx:id="ownerColumn" text="Propriétaire" prefWidth="150"/>
            <TableColumn fx:id="transportColumn" text="Transport" prefWidth="80"/>
            <TableColumn fx:id="visibleColumn" text="Visible" prefWidth="80"/>
        </columns>
    </TableView>
    
    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>
</VBox>
