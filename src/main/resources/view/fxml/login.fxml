<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greencore.controller.LoginController">
   <center>
      <VBox alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #2ecc71, #27ae60); -fx-padding: 40;">
         <children>
            <Label text="GREENCORE" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="36" />
               </font>
            </Label>
            <Label text="Gestion Communautaire de Matériel" textFill="WHITE">
               <font>
                  <Font size="14" />
               </font>
            </Label>
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10;">
               <children>
                  <Label text="Connexion" style="-fx-font-size: 18px; -fx-font-weight: bold;">
                     <VBox.margin>
                        <Insets bottom="20" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="emailField" promptText="Email" style="-fx-pref-width: 250;">
                     <VBox.margin>
                        <Insets bottom="10" />
                     </VBox.margin>
                  </TextField>
                  <PasswordField fx:id="passwordField" promptText="Mot de passe" style="-fx-pref-width: 250;">
                     <VBox.margin>
                        <Insets bottom="10" />
                     </VBox.margin>
                  </PasswordField>
                  <Label fx:id="errorLabel" visible="false" wrapText="true" style="-fx-pref-width: 250;">
                     <VBox.margin>
                        <Insets bottom="10" />
                     </VBox.margin>
                  </Label>
                  <Button fx:id="loginButton" onAction="#handleLogin" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 250; -fx-pref-height: 40;" text="Se connecter">
                     <VBox.margin>
                        <Insets bottom="10" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="registerButton" onAction="#handleRegister" style="-fx-background-color: transparent; -fx-text-fill: #2ecc71; -fx-border-color: #2ecc71; -fx-border-radius: 5; -fx-pref-width: 250; -fx-pref-height: 40;" text="Créer un compte" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
