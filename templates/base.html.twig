<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}GREENCORE{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌍</text></svg>">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
            <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
            <style>
                {% set current_theme = app.session.get('theme', 'default') %}
                
                /* Support RTL pour l'arabe */
                {% if app.request.locale == 'ar' %}
                    body {
                        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                        text-align: right;
                        direction: rtl;
                    }
                    .text-start { text-align: right !important; }
                    .text-end { text-align: left !important; }
                    .float-start { float: right !important; }
                    .float-end { float: left !important; }
                    .ms-3 { margin-right: 1rem !important; margin-left: 0 !important; }
                    .me-3 { margin-left: 1rem !important; margin-right: 0 !important; }
                    .ps-3 { padding-right: 1rem !important; padding-left: 0 !important; }
                    .pe-3 { padding-left: 1rem !important; padding-right: 0 !important; }
                {% endif %}
                
                /* Thème par défaut */
                {% if current_theme == 'default' %}
                body {
                    background: linear-gradient(180deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%);
                    min-height: 100vh;
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    color:  #1a1a1a;
                }
                .auth-container {
                    background: rgba(255, 255, 255, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                }
                .settings-card {
                    background: rgba(255, 255, 255, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                }
                .stats-card {
                    background: rgba(255, 255, 255, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                }
                {% endif %}
                
                /* Thème sombre */
                {% if current_theme == 'dark' %}
                body {
                    background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 50%, #404040 100%);
                    min-height: 100vh;
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    color: #ffffff;
                }
                .auth-container {
                    background: rgba(30, 30, 30, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
                    backdrop-filter: blur(10px);
                }
                .settings-card {
                    background: rgba(30, 30, 30, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
                    backdrop-filter: blur(10px);
                    color: #ffffff;
                }
                .stats-card {
                    background: rgba(30, 30, 30, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
                    backdrop-filter: blur(10px);
                    color: #ffffff;
                }
                {% endif %}
                
                /* Thème clair */
                {% if current_theme == 'light' %}
                body {
                    background: linear-gradient(180deg, #f5f5f5 0%, #e8e8e8 50%, #dcdcdc 100%);
                    min-height: 100vh;
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    color: #333333;
                }
                .auth-container {
                    background: rgba(255, 255, 255, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                }
                .settings-card {
                    background: rgba(255, 255, 255, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                    color: #333333;
                }
                .stats-card {
                    background: rgba(255, 255, 255, 0.95);
                    border-radius: 15px;
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                    color: #333333;
                }
                {% endif %}
                
                /* Style du logo */
                .logo {
                    font-size: 2rem;
                    font-weight: bold;
                    margin-bottom: 1rem;
                }
                
                /* Couleurs des boutons selon le thème */
                {% if current_theme == 'dark' %}
                .btn-primary {
                    background-color: #4caf50;
                    border-color: #4caf50;
                }
                .btn-primary:hover {
                    background-color: #388e3c;
                    border-color: #388e3c;
                }
                .logo {
                    color: #4caf50;
                }
                {% elseif current_theme == 'light' %}
                .btn-primary {
                    background-color: #4caf50;
                    border-color: #4caf50;
                }
                .btn-primary:hover {
                    background-color: #388e3c;
                    border-color: #388e3c;
                }
                .logo {
                    color: #4caf50;
                }
                {% else %}
                .btn-primary {
                    background-color: #4caf50;
                    border-color: #4caf50;
                }
                .btn-primary:hover {
                    background-color: #388e3c;
                    border-color: #388e3c;
                }
                .logo {
                    color: #4caf50;
                }
                {% endif %}
                
                .form-control:focus {
                    border-color: #4caf50;
                    box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
                }
                .navbar-brand {
                    color: #4caf50 !important;
                    font-weight: bold;
                }
                .card {
                    border: none;
                    border-radius: 15px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                }
                .table {
                    background: white;
                    border-radius: 10px;
                    overflow: hidden;
                }
                .table thead {
                    background-color: #4caf50;
                    color: white;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </head>
    <body>
        {% block navbar %}
            {% if app.user %}
                <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
                    <div class="container">
                        <a class="navbar-brand" href="{{ path('app_home') }}">
                            🌍 GREENCORE
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_dashboard') }}">
                                         Tableau de bord
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link d-flex align-items-center" href="{{ path('app_profile') }}">
                                        {% if app.user and app.user.profilePicture %}
                                            <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilePicture) }}" alt="Photo de profil" class="rounded-circle" style="width: 30px; height: 30px; object-fit: cover; margin-right: 8px;">
                                        {% else %}
                                            <span style="font-size: 1.2rem; margin-right: 8px;"></span>
                                        {% endif %}
                                        Profil
                                    </a>
                                </li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('app_admin_users') }}">
                                            Administration
                                        </a>
                                    </li>
                                {% endif %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_login') }}">
                                         Déconnexion
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            {% endif %}
        {% endblock %}

        <div class="container mt-4">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
