    <script>
        // Simuler le chargement des statistiques
        document.addEventListener('DOMContentLoaded', function() {
            // Animation des nombres
            animateValue('totalUsers', 0, {{ users_count|default(2) }}, 2000);
            animateValue('activeUsers', 0, {{ active_users_count|default(1) }}, 2000);
        });

        function animateValue(id, start, end, duration) {
            const obj = document.getElementById(id);
            const range = end - start;
            const minTimer = 50;
            let stepTime = Math.abs(Math.floor(duration / range));
            stepTime = Math.max(stepTime, minTimer);
            const startTime = new Date().getTime();
            const endTime = startTime + duration;
            let timer;

            function run() {
                const now = new Date().getTime();
                const remaining = Math.max((endTime - now) / duration, 0);
                const value = Math.round(end - (remaining * range));
                obj.innerHTML = value;
                if (value == end) {
                    clearInterval(timer);
                }
            }

            timer = setInterval(run, stepTime);
            run();
        }

        // Fonction de recherche avancée
        function performSearch() {
            const searchTerm = document.getElementById('searchInput').value.trim().toLowerCase();
            
            if (!searchTerm) {
                document.getElementById('searchInput').focus();
                return;
            }

            console.log('Recherche:', searchTerm);
            
            // Créer une interface de recherche
            showSearchResults(searchTerm);
        }

        function showSearchResults(searchTerm) {
            // Supprimer les résultats précédents
            const existingResults = document.getElementById('searchResults');
            if (existingResults) {
                existingResults.remove();
            }

            // Créer la modale de résultats
            const resultsModal = document.createElement('div');
            resultsModal.id = 'searchResults';
            resultsModal.className = 'modal fade show';
            resultsModal.style.display = 'block';
            resultsModal.style.backgroundColor = 'rgba(0,0,0,0.5)';
            
            resultsModal.innerHTML = `
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-light">
                            <h5 class="modal-title">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                                Résultats pour "${searchTerm}"
                            </h5>
                            <button type="button" class="btn-close" onclick="closeSearchResults()"></button>
                        </div>
                        <div class="modal-body">
                            ${generateSearchContent(searchTerm)}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" onclick="closeSearchResults()">Fermer</button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(resultsModal);
        }

        function generateSearchContent(searchTerm) {
            const searchCategories = [
                {
                    title: 'Utilisateurs',
                    icon:'user',
                    items: [
                        { name: 'Gestion des utilisateurs', url: '/admin/users', description: 'Voir et modifier les comptes utilisateurs' },
                        { name: 'Mon profil', url: '/profile', description: 'Voir et modifier mon profil' }
                    ]
                },
                {
                    title: 'Actions rapides',
                    icon:'person' ,
                    items: [
                        { name: 'Modifier profil', url: '/profile/edit', description: 'Mettre à jour mes informations' },
                        { name: 'Changer mot de passe', url: '/profile/change-password', description: 'Sécuriser mon compte' }
                    ]
                },
                {
                    title: 'Navigation',
                    icon:'home' ,
                    items: [
                        { name: 'Tableau de bord', url: '/dashboard', description: 'Retour au dashboard' },
                        { name: 'Accueil', url: '/', description: 'Page d\'accueil' },
                        { name: 'Déconnexion', url: '/logout', description: 'Quitter l\'application' }
                    ]
                }
            ];

            let html = '<div class="row">';
            
            searchCategories.forEach(category => {
                const filteredItems = category.items.filter(item => 
                    item.name.toLowerCase().includes(searchTerm) || 
                    item.description.toLowerCase().includes(searchTerm)
                );
                
                if (filteredItems.length > 0) {
                    html += `
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <span class="me-2">${category.icon}</span>
                                        ${category.title}
                                    </h6>
                                </div>
                                <div class="card-body">
                                    ${filteredItems.map(item => `
                                        <div class="mb-2">
                                            <a href="${item.url}" class="text-decoration-none">
                                                <div class="p-2 rounded hover-bg-light">
                                                    <strong>${highlightSearch(item.name, searchTerm)}</strong>
                                                    <br>
                                                    <small class="text-muted">${highlightSearch(item.description, searchTerm)}</small>
                                                </div>
                                            </a>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        </div>
                    `;
                }
            });
            
            html += '</div>';
            
            return html || '<p class="text-center text-muted">Aucun résultat trouvé pour "' + searchTerm + '"</p>';
        }

        function highlightSearch(text, searchTerm) {
            const regex = new RegExp(`(${searchTerm})`, 'gi');
            return text.replace(regex, '<mark>$1</mark>');
        }

        function closeSearchResults() {
            const resultsModal = document.getElementById('searchResults');
            if (resultsModal) {
                resultsModal.remove();
            }
            document.getElementById('searchInput').value = '';
            document.getElementById('searchInput').focus();
        }

        // Recherche avec la touche Entrée
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
    </script>
{% endblock %}

