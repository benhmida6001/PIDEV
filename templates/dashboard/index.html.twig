            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="mb-3" style="color: #2e7d32;">
                        Bienvenue {{ app.user.email }}
                    </h1>
                    <p class="text-muted mb-0">
                        {% if 'ROLE_ADMIN' in app.user.roles %}
                            {{ 'dashboard.administrator'|trans|default('Administrateur') }} • {{ 'dashboard.full_access'|trans|default('Accès complet à la plateforme') }}
                        {% else %}
                            {{ 'dashboard.user'|trans|default('Utilisateur') }} • {{ 'dashboard.manage_profile'|trans|default('Gérez votre profil et vos activités') }}
                        {% endif %}
                    </p>
                </div>
                <div class="col-md-4 text-center">
                    {% if app.user.profilePicture %}
                        <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilePicture) }}" alt="Photo de profil" class="profile-avatar">
                    {% else %}
                        <div class="profile-avatar d-flex align-items-center justify-content-center" style="background: #e8f5e8;">
                            <span style="font-size: 2rem; color: #2e7d32;"></span>
                        </div>
