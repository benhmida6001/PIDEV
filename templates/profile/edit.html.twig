{% block body %}
    <!-- Messages flash -->
    {% for type, messages in app.session.flashbag.all() %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">Modifier mon profil</h3>
                </div>
                <div class="card-body">
                    {{ form_start(profileForm, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-4">
                            {{ form_label(profileForm.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.nom, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.nom.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.nom.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.prenom, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.prenom.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.prenom.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.adresse, 'Adresse', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.adresse, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.adresse.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.adresse.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.age, 'Âge', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.age, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.age.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.age.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.email.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.email.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.profilePicture, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.profilePicture, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.profilePicture.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.profilePicture.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.sexe, 'Sexe', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(profileForm.sexe, {'attr': {'class': 'form-control'}}) }}
                            {% if profileForm.sexe.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in profileForm.sexe.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {% if app.user.profilePicture %}
                            <div class="mb-4">
                                <label class="form-label">Photo actuelle</label>
                                <div class="d-flex align-items-center">
                                    <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilePicture) }}" alt="Photo actuelle" 
                                         class="rounded-circle me-3" style="width: 80px; height: 80px; object-fit: cover;">
                                    <div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                                 Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(profileForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
