{% extends 'base.html.twig' %}

{% block title %}{{ 'Changer le mot de passe - GREENCORE'|trans }} - {{ 'app.name'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Thèmes dynamiques */
        {% if current_theme == 'dark' %}
            body {
                background-color: #1a202c !important;
                color: #e2e8f0 !important;
                background: linear-gradient(180deg, #1a202c 0%, #2d3748 50%, #4a5568 100%) !important;
                min-height: 100vh;
            }
            .card {
                background-color: #2d3748 !important;
                color: #e2e8f0 !important;
                border: 1px solid #4a5568 !important;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            }
            .card-header {
                background: linear-gradient(135deg, #2d3748, #4a5568) !important;
                color: #e2e8f0 !important;
                border-radius: 15px 15px 0 0 !important;
            }
            .form-control {
                background-color: #2d3748 !important;
                border: 2px solid #4a5568 !important;
                color: #e2e8f0 !important;
                font-weight: 500;
                padding: 12px 15px;
                border-radius: 8px;
            }
            .form-control:focus {
                background-color: #374151 !important;
                border-color: #4caf50 !important;
                color: #e2e8f0 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
            .form-label {
                color: #e2e8f0 !important;
                font-weight: 600;
                margin-bottom: 8px;
            }
            .alert {
                background-color: #2d3748 !important;
                border-color: #4a5568 !important;
                color: #e2e8f0 !important;
                border-radius: 8px;
                margin-bottom: 1rem;
            }
            .text-danger {
                color: #fc8181 !important;
            }
        {% elseif current_theme == 'light' %}
            body {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 50%, #e9ecef 100%) !important;
                min-height: 100vh;
            }
            .card {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                border: 1px solid #e9ecef !important;
                border-radius: 15px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }
            .card-header {
                background: linear-gradient(135deg, #4caf50, #66bb6a) !important;
                color: white !important;
                border-radius: 15px 15px 0 0 !important;
            }
            .form-control {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                font-weight: 500;
                padding: 12px 15px;
                border-radius: 8px;
            }
            .form-control:focus {
                background-color: #f8f9fa !important;
                border-color: #388e3c !important;
                color: #2d3748 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
            .form-label {
                color: #000000 !important;
                font-weight: 600;
                margin-bottom: 8px;
            }
            .alert {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                border-radius: 8px;
                margin-bottom: 1rem;
            }
        {% else %}
            /* Thème par défaut - Vert complet */
            body {
                background: linear-gradient(180deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%) !important;
                min-height: 100vh;
            }
            .card {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                border: 2px solid #4caf50 !important;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(76, 175, 80, 0.3);
            }
            .card-header {
                background: linear-gradient(135deg, #2e7d32, #43a047) !important;
                color: white !important;
                border-radius: 15px 15px 0 0 !important;
                border-bottom: 2px solid #4caf50 !important;
            }
            .form-control {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                font-weight: 500;
                padding: 12px 15px;
                border-radius: 8px;
            }
            .form-control:focus {
                background-color: #f8f9fa !important;
                border-color: #388e3c !important;
                color: #2d3748 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
            .form-label {
                color: #2e7d32 !important;
                font-weight: 600;
                margin-bottom: 8px;
            }
            .alert {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                border-radius: 8px;
                margin-bottom: 1rem;
            }
            .text-muted {
                color: #2e7d32 !important;
            }
        {% endif %}
        
        .btn-primary {
            background-color: #4caf50;
            border-color: #4caf50;
            font-weight: 600;
            padding: 12px 30px;
            border-radius: 8px;
        }
        
        .btn-primary:hover {
            background-color: #388e3c;
            border-color: #388e3c;
        }
        
        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
        }
        
        .alert {
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        
        .password-strength {
            margin-top: 5px;
            font-size: 0.875rem;
        }
        
        .strength-weak { color: #f44336; }
        .strength-medium { color: #ff9800; }
        .strength-strong { color: #4caf50; }
    </style>
{% endblock %}

{% block body %}
    <!-- Messages flash -->
    {% for type, messages in app.session.flashbag.all() %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0">Changer le mot de passe</h3>
                </div>
                <div class="card-body">
                    {{ form_start(changePasswordForm, {'attr': {'novalidate': 'novalidate'}}) }}
                        <div class="mb-3">
                            {{ form_label(changePasswordForm.currentPassword, 'Mot de passe actuel', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(changePasswordForm.currentPassword, {'attr': {'class': 'form-control'}}) }}
                            {% if changePasswordForm.currentPassword.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in changePasswordForm.currentPassword.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(changePasswordForm.newPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(changePasswordForm.newPassword.first, {'attr': {'class': 'form-control', 'id': 'newPassword'}}) }}
                            {% if changePasswordForm.newPassword.first.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in changePasswordForm.newPassword.first.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <div class="password-strength" id="passwordStrength"></div>
                        </div>

                        <div class="mb-4">
                            {{ form_label(changePasswordForm.newPassword.second, 'Confirmer le nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(changePasswordForm.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                            {% if changePasswordForm.newPassword.second.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in changePasswordForm.newPassword.second.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                                Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                 Changer le mot de passe
                            </button>
                        </div>
                    {{ form_end(changePasswordForm) }}
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('newPassword').addEventListener('input', function(e) {
            const password = e.target.value;
            const strengthElement = document.getElementById('passwordStrength');
            
            if (password.length < 6) {
                strengthElement.textContent = 'Faible : minimum 6 caractères';
                strengthElement.className = 'password-strength strength-weak';
            } else if (password.length < 10) {
                strengthElement.textContent = 'Moyen';
                strengthElement.className = 'password-strength strength-medium';
            } else {
                strengthElement.textContent = 'Fort';
                strengthElement.className = 'password-strength strength-strong';
            }
        });
    </script>
{% endblock %}
