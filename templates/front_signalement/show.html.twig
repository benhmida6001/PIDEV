{% extends 'front.html.twig' %}

{% block title %}Suivi du signalement #{{ signalement.idSignalement }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        {# Fil d'ariane pour revenir à l'accueil fluide #}
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_signalement_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Signalement #{{ signalement.idSignalement }}</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Détails du Ticket #{{ signalement.idSignalement }}</h1>
            <span class="badge {% if signalement.statutTraitement == 'En attente' %}bg-warning text-dark{% else %}bg-success{% endif %} p-2">
                {{ signalement.statutTraitement|upper }}
            </span>
        </div>

        {# --- BLOC IMAGE --- #}
        {% if signalement.imageUrl %}
            <div class="mb-4 text-center">
                <img src="{{ asset('assets_sc/uploads/' ~ signalement.imageUrl) }}" 
                     alt="Image du signalement" 
                     class="img-fluid rounded shadow-sm border" 
                     style="max-height: 400px; width: auto; object-fit: contain;">
            </div>
        {% else %}
            <div class="alert alert-light text-muted border-dashed text-center mb-4">
                <i class="fa-solid fa-image-slash"></i> Aucune image jointe à ce signalement.
            </div>
        {% endif %}

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="text-muted border-bottom pb-2">Informations Générales</h5>
                        <p class="mt-3"><strong>Description :</strong><br>{{ signalement.description }}</p>
                        <p><strong>Lieu :</strong> {{ signalement.localisation }}</p>
                        <p class="text-muted small italic">Signalé le {{ signalement.dateCreation|date('d/m/Y à H:i') }}</p>
                    </div>

                    <div class="col-md-4 border-start">
                        <h5 class="text-muted border-bottom pb-2">Catégorisation</h5>
                        <div class="mt-3">
                            {% if signalement.statutTraitement == 'En attente' %}
                                <div class="text-center p-3 bg-light rounded">
                                    <i class="fa-solid fa-clock-rotate-left fa-2x text-secondary mb-2"></i><br>
                                    <span class="text-muted small">Analyse en cours par nos agents...</span>
                                </div>
                            {% else %}
                                <div class="alert alert-info border-0 shadow-sm">
                                    <i class="fa-solid fa-tag me-2"></i>
                                    <strong>{{ signalement.idCategorie ? signalement.idCategorie.nomCategorie : 'Non classé' }}</strong>
                                </div>

                                {# Aide / Réclamation #}
                                <div class="mt-4">
                                    <p class="small text-muted">Une erreur sur la catégorie ?</p>
                                    <a href="mailto:contact@greencore.com?subject=Erreur Catégorie Ticket #{{ signalement.idSignalement }}" 
                                       class="btn btn-sm btn-outline-warning w-100">
                                        <i class="fa-solid fa-envelope"></i> Réclamer par Email
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5 p-4 bg-light rounded d-flex justify-content-between align-items-center shadow-sm">
            <div>
                <a href="{{ path('app_signalement_home') }}" class="btn btn-outline-primary">
                    <i class="fa-solid fa-arrow-left"></i> Nouvelle recherche
                </a>
                <a href="{{ path('app_front_signalement_pdf', {'id_signalement': signalement.idSignalement}) }}" class="btn btn-secondary">
    <i class="fa-solid fa-file-pdf"></i> Télécharger le ticket (PDF)
</a>
            </div>
            
            <div class="text-end">
                <p class="small text-danger mb-1">Vous ne souhaitez plus suivre ce ticket ?</p>
                {# Le Faux Bouton Supprimer (Archivage) #}
                <form method="post" action="{{ path('app_front_signalement_delete', {'id_signalement': signalement.idSignalement}) }}" onsubmit="return confirm('Attention : vous ne pourrez plus consulter ce signalement avec votre code. Confirmer ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ signalement.idSignalement) }}">
                    <button class="btn btn-danger">
                        <i class="fa-solid fa-eye-slash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}