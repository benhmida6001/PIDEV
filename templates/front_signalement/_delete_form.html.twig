<form method="post" action="{{ path('app_front_signalement_delete', {'id_signalement': signalement.idSignalement}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce signalement ?');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ signalement.idSignalement) }}">
    <button class="btn btn-danger">
        <i class="fa-solid fa-trash"></i> Supprimer
    </button>
</form>