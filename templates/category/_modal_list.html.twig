<div class="mb-3">
    <button type="button" class="btn btn-primary" id="addCategoryBtn">
        <i class="bi bi-plus-circle"></i> Add Category
    </button>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-warning edit-category-btn" 
                                data-url="{{ path('app_category_modal_edit', {'id': category.id}) }}">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button type="button" class="btn btn-danger delete-category-btn" 
                                data-url="{{ path('app_category_modal_delete', {'id': category.id}) }}">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="text-center">No categories found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>