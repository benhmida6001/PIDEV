{% extends 'base.html.twig' %}

{% block title %}{{ 'Créer un utilisateur'|trans }} - {{ 'GREENCORE'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Thèmes dynamiques */
        {% if current_theme == 'dark' %}
            body {
                background-color: #1a202c !important;
                color: #e2e8f0 !important;
                background: linear-gradient(180deg, #1a202c 0%, #2d3748 50%, #4a5568 100%) !important;
                min-height: 100vh;
            }
            .card {
                background-color: #2d3748 !important;
                color: #e2e8f0 !important;
                border: 1px solid #4a5568 !important;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            }
            .card-header {
                background: linear-gradient(135deg, #2d3748, #4a5568) !important;
                color: #e2e8f0 !important;
                border-radius: 15px 15px 0 0 !important;
            }
            .form-control {
                background-color: #2d3748 !important;
                border: 2px solid #4a5568 !important;
                color: #e2e8f0 !important;
                font-weight: 500;
                padding: 12px 15px;
                border-radius: 8px;
            }
            .form-control:focus {
                background-color: #374151 !important;
                border-color: #4caf50 !important;
                color: #e2e8f0 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
            .form-label {
                color: #e2e8f0 !important;
                font-weight: 600;
                margin-bottom: 8px;
            }
            .alert {
                background-color: #2d3748 !important;
                border-color: #4a5568 !important;
                color: #e2e8f0 !important;
                border-radius: 8px;
                margin-bottom: 1rem;
            }
            .text-danger {
                color: #fc8181 !important;
            }
        {% elseif current_theme == 'light' %}
            body {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 50%, #e9ecef 100%) !important;
                min-height: 100vh;
            }
            .card {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                border: 1px solid #e9ecef !important;
                border-radius: 15px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }
            .card-header {
                background: linear-gradient(135deg, #4caf50, #66bb6a) !important;
                color: white !important;
                border-radius: 15px 15px 0 0 !important;
            }
            .form-control {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                font-weight: 500;
                padding: 12px 15px;
                border-radius: 8px;
            }
            .form-control:focus {
                background-color: #f8f9fa !important;
                border-color: #388e3c !important;
                color: #2d3748 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
            .form-label {
                color: #000000 !important;
                font-weight: 600;
                margin-bottom: 8px;
            }
            .alert {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                border-radius: 8px;
                margin-bottom: 1rem;
            }
        {% else %}
            /* Thème par défaut - Vert complet */
            body {
                background: linear-gradient(180deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%) !important;
                min-height: 100vh;
            }
            .card {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                border: 2px solid #4caf50 !important;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(76, 175, 80, 0.3);
            }
            .card-header {
                background: linear-gradient(135deg, #2e7d32, #43a047) !important;
                color: white !important;
                border-radius: 15px 15px 0 0 !important;
                border-bottom: 2px solid #4caf50 !important;
            }
            .form-control {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                font-weight: 500;
                padding: 12px 15px;
                border-radius: 8px;
            }
            .form-control:focus {
                background-color: #f8f9fa !important;
                border-color: #388e3c !important;
                color: #2d3748 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
            .form-label {
                color: #2e7d32 !important;
                font-weight: 600;
                margin-bottom: 8px;
            }
            .alert {
                background-color: #ffffff !important;
                border: 2px solid #4caf50 !important;
                color: #2d3748 !important;
                border-radius: 8px;
                margin-bottom: 1rem;
            }
            .text-muted {
                color: #2e7d32 !important;
            }
            .form-check-input:checked {
                background-color: #4caf50 !important;
                border-color: #4caf50 !important;
            }
            .form-check-input:focus {
                border-color: #4caf50 !important;
                box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            }
        {% endif %}
        
        .btn-primary {
            background-color: #4caf50;
            border-color: #4caf50;
            font-weight: 600;
            padding: 12px 20px;
            border-radius: 8px;
        }
        
        .btn-primary:hover {
            background-color: #45a049;
            border-color: #45a049;
        }
        
        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            font-weight: 600;
            padding: 12px 20px;
            border-radius: 8px;
        }
        
        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #5a6268;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Messages flash -->
    {% for type, messages in app.session.flashbag.all() %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">Créer un utilisateur</h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="mb-3">
                                {{ form_label(form.email,'Email'|trans, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                                {% if form.email.vars.errors|length > 0 %}
                                    <div class="alert alert-danger mt-2">
                                        {% for error in form.email.vars.errors %}
                                            <small class="d-block">{{ error.message }}</small>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.password.first, 'Password'|trans, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.password.first, {'attr': {'class': 'form-control'}}) }}
                                {% if form.password.first.vars.errors|length > 0 %}
                                    <div class="alert alert-danger mt-2">
                                        {% for error in form.password.first.vars.errors %}
                                            <small class="d-block">{{ error.message }}</small>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.password.second, 'Confirm Password'|trans, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.password.second, {'attr': {'class': 'form-control'}}) }}
                                {% if form.password.second.vars.errors|length > 0 %}
                                    <div class="alert alert-danger mt-2">
                                        {% for error in form.password.second.vars.errors %}
                                            <small class="d-block">{{ error.message }}</small>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            {% if form.password.vars.errors|length > 0 %}
                                <div class="alert alert-danger mt-2">
                                    {% for error in form.password.vars.errors %}
                                        <small class="d-block">{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                {{ form_label(form.roles, 'Roles'|trans, {'label_attr': {'class': 'form-label'}}) }}
                                <div class="form-check">
                                    {% for child in form.roles %}
                                        <div class="form-check">
                                            {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(child, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                        </div>
                                    {% endfor %}
                                </div>
                                {% if form.roles.vars.errors|length > 0 %}
                                    <div class="text-danger mt-1">
                                        {% for error in form.roles.vars.errors %}
                                            <small>{{ error.message }}</small>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">
                                    Retour 
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
