{% block body %}
    <!-- Messages flash -->
    {% for type, messages in app.session.flashbag.all() %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-light mb-2">
                 Retour
            </a>
                <!-- Barre supérieure -->
    <div class="container mt-4">
        <div class="top-bar">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="search-box">
                        <input type="text" placeholder="Rechercher par email, nom, âge, rôle..." id="searchInput" class="form-control form-control-lg">
                        <button type="button" onclick="performSearch()" class="btn btn-success btn-lg">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div class="profile-actions d-inline-flex align-items-center">
                        <span class="me-3 text-muted">
                            {% if app.user and app.user.profilePicture %}
                                <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilePicture) }}" alt="Photo" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover; margin-right: 8px;">
                            {% endif %}
                           
                    </div>
                </div>
            </div>
        </div>
    </div>
            <h1 style="color: white;">Gestion des Utilisateurs</h1>
        </div>
        <div>
            <span class="badge bg-primary">{{ users|length }} utilisateurs</span>
            <a href="{{ path('app_admin_user_create') }}" class="btn btn-success ms-2">
                 Créer un utilisateur
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Liste des utilisateurs</h5>
        </div>
        <div class="card-body">
            {% if users|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Email</th>
                                <th>Nom complet</th>
                                <th>Âge</th>
                                <th>Rôles</th>
                                <th>Date de création</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">{{ user.id }}</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            {% if user.profilePicture %}
                                                <img src="{{ asset('uploads/profile_pictures/' ~ user.profilePicture) }}" alt="Photo" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;">
                                            {% else %}
                                                <div class="rounded-circle bg-light me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                    
                                                </div>
                                            {% endif %}
                                            <div>
                                                <strong>{{ user.email }}</strong>
                                                {% if app.user.email == user.email %}
                                                    <span class="badge bg-info ms-2">Vous</span>
                                                {% endif %}
                                                {% if user.nom or user.prenom %}
                                                    <div class="text-muted small">{{ user.prenom }} {{ user.nom }}</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% if user.nom or user.prenom %}
                                            {{ user.prenom }} {{ user.nom }}
                                        {% else %}
                                            <span class="text-muted">Non renseigné</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if user.age %}
                                            <span class="badge bg-info">{{ user.age }} ans</span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% for role in user.roles %}
                                            {% if role != 'ROLE_USER' %}
                                                <span class="badge bg-{{ role == 'ROLE_ADMIN' ? 'danger' : 'warning' }}" style="background-color: {{ role == 'ROLE_ADMIN' ? '#ef5350' : '#ffa726' }} !important;">
                                                    {{ role == 'ROLE_ADMIN' ? 'Admin' : role }}
                                                </span>
                                            {% endif %}
                                        {% endfor %}
                                        {% if user.roles|length == 1 %}
                                            <span class="badge bg-primary" style="background-color: #4caf50 !important;">User</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            Il y a peu de temps
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_admin_user_view', {'id': user.id}) }}" class="btn btn-primary" title="Voir le profil">
                                                Voir
                                            </a>
                                            {% if app.user.email != user.email %}
                                                <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-warning" title="Modifier les rôles">
                                                    Modifier
                                                </a>
                                                <form method="POST" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ? Cette action est irréversible.');">
                                                    <button type="submit" class="btn btn-danger" title="Supprimer">
                                                        delete
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div style="font-size: 3rem; opacity: 0.5;"></div>
                    <h4 class="text-muted">Aucun utilisateur trouvé</h4>
                    <p class="text-muted">Commencez par inviter des membres à rejoindre la plateforme.</p>
                </div>
            {% endif %}
        </div>
    </div>
            </div>
        </div>
        <div class="row mt-4">
        <div class="col-md-2-4">
            <div class="card text-center">
                <div class="card-body">
                </div>
    </div>
    <script>
        function performSearch() {
            const searchInput = document.getElementById('searchInput').value.toLowerCase();
            const tableRows = document.querySelectorAll('tbody tr');
            
            tableRows.forEach(row => {
                const email = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                const nomComplet = row.querySelector('td:nth-child(3)').textContent.toLowerCase();
                const age = row.querySelector('td:nth-child(4)').textContent.toLowerCase();
                const roles = row.querySelector('td:nth-child(5)').textContent.toLowerCase();
                
                // Recherche dans email, nom complet, âge et rôles
                const searchableText = email + ' ' + nomComplet + ' ' + age + ' ' + roles;
                
                if (searchableText.includes(searchInput)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        
        // Recherche en temps réel
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('input', performSearch);
            }
        });
    </script>
{% endblock %}

