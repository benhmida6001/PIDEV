{% extends 'base.html.twig' %}

{% block title %}Gestion des Rôles - {{ 'GREENCORE'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .roles-container {
            min-height: 100vh;
            padding: 20px;
        }
        
        .roles-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .roles-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }
        
        .table {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .table thead {
            background: linear-gradient(45deg, #28a745, #20c997);
            color: white;
        }
        
        .table thead th {
            border: none;
            padding: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-color: #f0f0f0;
        }
        
        .table tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
            transition: all 0.3s ease;
        }
        
        .badge {
            padding: 8px 12px;
            border-radius: 20px;
            font-weight: 600;
            margin: 2px;
        }
        
        .badge-primary {
            background: linear-gradient(45deg, #007bff, #0056b3);
            color: white;
        }
        
        .badge-success {
            background: linear-gradient(45deg, #28a745, #1e7e34);
            color: white;
        }
        
        .btn-info {
            background: linear-gradient(45deg, #17a2b8, #138496);
            border: none;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-info:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(23, 162, 184, 0.3);
        }
        
        .btn-warning {
            background: linear-gradient(45deg, #ffc107, #e0a800);
            border: none;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
        }
        
        .btn-secondary {
            background: linear-gradient(45deg, #6c757d, #5a6268);
            border: none;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
        }
        
        .alert-success {
            background: linear-gradient(45deg, #d4edda, #c3e6cb);
            border: none;
            border-radius: 10px;
            color: #155724;
        }
        
        .alert-info {
            background: linear-gradient(45deg, #d1ecf1, #bee5eb);
            border: none;
            border-radius: 10px;
            color: #0c5460;
        }
        
        .alert-error {
            background: linear-gradient(45deg, #f8d7da, #f5c6cb);
            border: none;
            border-radius: 10px;
            color: #721c24;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 10px;
        }
        
        .user-info {
            display: flex;
            align-items: center;
        }
        
        .user-email {
            font-weight: 600;
            color: #333;
        }
        
        .user-id {
            color: #666;
            font-size: 0.9em;
        }
        
        .actions-cell {
            display: flex;
            gap: 8px;
            justify-content: center;
        }
        
        .header-title {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }
        
        .header-title h1 {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        .header-title p {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        .stats-row {
            display: flex;
            justify-content: space-around;
            margin-bottom: 30px;
            gap: 20px;
        }
        
        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            flex: 1;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: #28a745;
        }
        
        .stat-label {
            color: #666;
            font-size: 0.9rem;
            margin-top: 5px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="roles-container">
    <div class="container">
        
        <!-- En-tête -->
        <div class="header-title">
            <h1>
               Gestion des Rôles
            </h1>
            <p>Administrateur les permissions et les rôles des utilisateurs</p>
        </div>

        <!-- Messages flash -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-check-circle"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('info') %}
            <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-info-circle"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-error alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-exclamation-circle"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <!-- Statistiques -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-number">{{ users|length }}</div>
                <div class="stat-label">Total Utilisateurs</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ users|filter(user => 'ROLE_ADMIN' in user.roles)|length }}</div>
                <div class="stat-label">Administrateurs</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ users|filter(user => 'ROLE_ADMIN' not in user.roles)|length }}</div>
                <div class="stat-label">Utilisateurs</div>
            </div>
        </div>

        <!-- Tableau des utilisateurs -->
        <div class="roles-card">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th> ID</th>
                            <th> Utilisateur</th>
                            <th> Email</th>
                            <th> Rôles</th>
                            <th> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>
                                    <span class="user-id">{{ user.id }}</span>
                                </td>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar">
                                            {{ user.email|first|upper }}
                                        </div>
                                        <div>
                                            <div class="user-email">{{ user.email }}</div>
                                            <small class="text-muted">
                                                {% if user.lastLogin %}
                                                    Dernière connexion: {{ user.lastLogin|date('d/m/Y H:i') }}
                                                {% else %}
                                                    Jamais connecté
                                                {% endif %}
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:{{ user.email }}" class="text-decoration-none">
                                         {{ user.email }}
                                    </a>
                                </td>
                                <td>
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_ADMIN' %}
                                            <span class="badge badge-success">
                                                 Admin
                                            </span>
                                        {% else %}
                                            <span class="badge badge-primary">
                                                 {{ role|replace({'ROLE_': ''}) }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </td>
                                <td>
                                    <div class="actions-cell">
                                        {# Promouvoir en Admin #}
                                        {% if 'ROLE_ADMIN' not in user.roles %}
                                            <a href="{{ path('app_user_promote', {id: user.id}) }}"
                                               class="btn btn-sm btn-warning"
                                               title="Promouvoir administrateur"
                                               onclick="return confirm('Promouvoir {{ user.email }} comme administrateur ?')">
                                                Admin
                                            </a>
                                        {% endif %}

                                        {# Rétrograder en User #}
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            <a href="{{ path('app_user_demote', {id: user.id}) }}"
                                               class="btn btn-sm btn-secondary"
                                               title="Rétrograder utilisateur"
                                               onclick="return confirm('Rétrograder {{ user.email }} en utilisateur simple ?')">
                                                 User
                                            </a>
                                        {% endif %}

                                        {# Envoyer email de réinitialisation #}
                                        <a href="{{ path('app_user_send_reset', {id: user.id}) }}"
                                           class="btn btn-sm btn-info"
                                           title="Envoyer email de réinitialisation"
                                           onclick="return confirm('Envoyer un email de réinitialisation à {{ user.email }} ?')">
                                             Reset
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    
                                    <h5>Aucun utilisateur trouvé</h5>
                                    <p>Commencez par ajouter des utilisateurs au système</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Boutons d'action -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div>
                    <button class="btn btn-outline-primary" onclick="refreshPage()">
                         Actualiser
                    </button>
                </div>
                
                <div>
                    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
                         Retour 
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function refreshPage() {
            location.reload();
        }

        // Animation des lignes du tableau
        document.querySelectorAll('tbody tr').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#f8f9fa';
            });
            
            row.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });

        // Confirmation améliorée
        document.querySelectorAll('a[onclick]').forEach(link => {
            link.addEventListener('click', function(e) {
                const confirmMessage = this.getAttribute('onclick').match(/confirm\('([^']+)'\)/);
                if (confirmMessage) {
                    if (!confirm(confirmMessage[1])) {
                        e.preventDefault();
                    }
                }
            });
        });

        // Auto-rafraîchissement toutes les 30 secondes
        setTimeout(() => {
            location.reload();
        }, 30000);
    </script>
{% endblock %}
