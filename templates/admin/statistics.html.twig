{% extends 'base.html.twig' %}

{% block title %}Statistiques - {{ 'GREENCORE'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Thèmes dynamiques */
        {% if current_theme == 'dark' %}
            body {
                background-color: #1a202c !important;
                color: #e2e8f0 !important;
                background: linear-gradient(180deg, #1a202c 0%, #2d3748 50%, #4a5568 100%) !important;
                min-height: 100vh;
            }
            .stats-container {
                background-color: #2d3748 !important;
                color: #e2e8f0 !important;
                min-height: 100vh;
                padding: 10px;
            }
            .stats-card {
                background-color: #2d3748 !important;
                color: #e2e8f0 !important;
                backdrop-filter: blur(10px);
                border: 1px solid #4a5568 !important;
                border-radius: 20px;
                padding: 25px;
                margin-bottom: 25px;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            }
            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
            }
            .stat-number {
                font-size: 2.5rem;
                font-weight: bold;
                background: linear-gradient(45deg, #4caf50, #66bb6a);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .stat-label {
                color: #e2e8f0 !important;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            .chart-container {
                background-color: #2d3748 !important;
                border: 1px solid #4a5568 !important;
                border-radius: 15px;
                padding: 20px;
                position: relative;
                height: 300px;
                margin: 20px 0;
            }
            .metric-card {
                background: linear-gradient(135deg, #2d3748, #4a5568) !important;
                color: #e2e8f0 !important;
                border: 1px solid #4a5568 !important;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
            }
            .table {
                background-color: #2d3748 !important;
                color: #e2e8f0 !important;
                border-radius: 10px;
                overflow: hidden;
            }
            .table thead th {
                background-color: #4a5568 !important;
                color: #e2e8f0 !important;
                border-bottom: 2px solid #4a5568 !important;
            }
        {% elseif current_theme == 'light' %}
            body {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 50%, #e9ecef 100%) !important;
                min-height: 100vh;
            }
            .stats-container {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                min-height: 100vh;
                padding: 10px;
            }
            .stats-card {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                backdrop-filter: blur(10px);
                border: 1px solid #e9ecef !important;
                border-radius: 20px;
                padding: 25px;
                margin-bottom: 25px;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }
            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            }
            .stat-number {
                font-size: 2.5rem;
                font-weight: bold;
                background: linear-gradient(45deg, #4caf50, #66bb6a);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .stat-label {
                color: #6c757d !important;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            .chart-container {
                background-color: #ffffff !important;
                border: 1px solid #e9ecef !important;
                border-radius: 15px;
                padding: 20px;
                position: relative;
                height: 300px;
                margin: 20px 0;
            }
            .metric-card {
                background: linear-gradient(135deg, #f8f9fa, #e9ecef) !important;
                color: #2d3748 !important;
                border: 1px solid #e9ecef !important;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
            }
            .table {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                border-radius: 10px;
                overflow: hidden;
            }
            .table thead th {
                background-color: #f8f9fa !important;
                color: #2d3748 !important;
                border-bottom: 2px solid #e9ecef !important;
            }
        {% else %}
            /* Thème par défaut - Vert et blanc */
            body {
                background: linear-gradient(180deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%);
                min-height: 100vh;
            }
            .stats-container {
                color: #2d3748 !important;
                min-height: 100vh;
                padding: 10px;
            }
            .stats-card {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                backdrop-filter: blur(10px);
                border: none;
                border-radius: 20px;
                padding: 25px;
                margin-bottom: 25px;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            }
            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            }
            .stat-number {
                font-size: 2.5rem;
                font-weight: bold;
                background: linear-gradient(45deg, #4caf50, #66bb6a);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .stat-label {
                color: #6c757d !important;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            .chart-container {
                background-color: #ffffff !important;
                border: none;
                border-radius: 15px;
                padding: 20px;
                position: relative;
                height: 300px;
                margin: 20px 0;
            }
            .metric-card {
                background: linear-gradient(135deg, #e8f5e8, #c8e6c9) !important;
                color: #2d3748 !important;
                border: none;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
            }
            .table {
                background-color: #ffffff !important;
                color: #2d3748 !important;
                border-radius: 10px;
                overflow: hidden;
            }
            .table thead th {
                background-color: #e8f5e8 !important;
                color: #2d3748 !important;
                border-bottom: 2px solid #4caf50 !important;
            }
        {% endif %}
            padding: 20px;
            text-align: center;
            transition: transform 0.3s ease;
        }
        
        .metric-card:hover {
            transform: scale(1.05);
        }
        
        .activity-item {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 10px;
            border-left: 4px solid #667eea;
        }
        
        .trend-positive {
            color: #4caf50;
            font-weight: bold;
        }
        
        .trend-negative {
            color: #f44336;
            font-weight: bold;
        }
        
        .export-btn {
            background: linear-gradient(45deg, #4caf50, #45a049);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .export-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
        }
    </style>
{% endblock %}

{% block body %}
<div class="stats-container">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="text-white text-center mb-4">
                    Tableau de Statistique
                </h1>
            </div>
        </div>

        <!-- Statistiques principales -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="stats-card text-center">
                    <div class="stat-number">{{ totalUsers }}</div>
                    <div class="stat-label">Total Utilisateurs</div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stats-card text-center">
                    <div class="stat-number">{{ activeUsers }}</div>
                    <div class="stat-label">Utilisateurs Actifs</div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stats-card text-center">
                    <div class="stat-number">{{ newUsersThisMonth }}</div>
                    <div class="stat-label">Nouveaux ce Mois</div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stats-card text-center">
                    <div class="stat-number">
                        {% if totalUsers > 0 %}
                            {{ ((activeUsers / totalUsers) * 100)|round(1) }}%
                        {% else %}
                            0%
                        {% endif %}
                    </div>
                    <div class="stat-label">Taux d'Activité</div>
                </div>
            </div>
        </div>
       <!-- Nouveaux graphiques d'activité -->
        <div class="row mb-4">
