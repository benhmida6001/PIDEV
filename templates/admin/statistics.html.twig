                                    <strong>{{ ageDistribution['26-35 ans'] }}</strong>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5>Activité</h5>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Utilisateurs Actifs</span>
                                    <strong>{{ activeUsersCount }}</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Utilisateurs Inactifs</span>
                                    <strong>{{ inactiveUsersCount }}</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Administrateurs</span>
                                    <strong>{{ adminUsers }}</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Utilisateurs Standard</span>
                                    <strong>{{ userUsers }}</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Nouveaux ce mois</span>
                                    <strong>{{ newUsersThisMonth }}</strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        console.log('=== DÉBUT DES STATISTIQUES ===');
        console.log('Total users:', {{ totalUsers|default(0) }});
        console.log('Male users:', {{ maleUsers|default(0) }});
        console.log('Female users:', {{ femaleUsers|default(0) }});
        console.log('Monthly registrations:', {{ monthlyRegistrations|json_encode|raw }});
        console.log('New users this month:', {{ newUsersThisMonth|default(0) }});
        
        // Vérifier si Chart.js est chargé
        if (typeof Chart === 'undefined') {
            console.error('Chart.js n\'est pas chargé !');
            alert('Erreur : Chart.js n\'est pas chargé. Veuillez recharger la page.');
            return;
        }
        
        console.log('Chart.js est chargé, version:', Chart.version);
        
        // Graphique de répartition par devices
        console.log('=== CRÉATION GRAPHIQUE DEVICES ===');
        const deviceCtx = document.getElementById('deviceChart');
        if (!deviceCtx) {
            console.error('Canvas deviceChart non trouvé !');
        } else {
            console.log('Canvas deviceChart trouvé:', deviceCtx);
            try {
                const mobileCount = {{ mobileUsers|default(40) }};
                const desktopCount = {{ desktopUsers|default(60) }};
                
                new Chart(deviceCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Mobile', 'Desktop'],
                        datasets: [{
                            data: [mobileCount, desktopCount],
                            backgroundColor: ['#2196F3', '#4CAF50'], // Bleu et Vert vifs
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    font: {
                                        size: 14
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.parsed + '%';
                                    }
                                }
                            }
                        }
                    }
                });
                console.log('Graphique devices créé avec succès');
            } catch (error) {
                console.error('Erreur création graphique devices:', error);
            }
        }

        // Graphique d'évolution mensuelle
        console.log('=== CRÉATION GRAPHIQUE MENSUEL ===');
        console.log('Monthly registrations data:', {{ monthlyRegistrations|json_encode|raw }});
        const monthlyCtx = document.getElementById('monthlyChart');
        if (!monthlyCtx) {
            console.error('Canvas monthlyChart non trouvé !');
        } else {
            console.log('Canvas monthlyChart trouvé:', monthlyCtx);
            try {
                // Données de secours si vide
                const defaultMonthlyData = {
                    'Jan': 2, 'Fév': 3, 'Mar': 1, 'Avr': 4, 'Mai': 2,
                    'Jun': 5, 'Jul': 3, 'Août': 4, 'Sep': 2, 'Oct': 3, 'Nov': 2, 'Déc': 4
                };
                
                const finalMonthlyData = Object.keys({{ monthlyRegistrations|json_encode|raw }}).length > 0 
                    ? {{ monthlyRegistrations|json_encode|raw }} 
                    : defaultMonthlyData;
                
                console.log('Final monthly data:', finalMonthlyData);
                
                new Chart(monthlyCtx.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: Object.keys(finalMonthlyData),
                        datasets: [{
                            label: 'Inscriptions',
                            data: Object.values(finalMonthlyData),
                            borderColor: '#2196F3', // Bleu vif
                            backgroundColor: 'rgba(33, 150, 243, 0.1)',
                            tension: 0.4,
                            fill: true,
                            borderWidth: 3,
                            pointBackgroundColor: '#2196F3',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
                console.log('Graphique mensuel créé avec succès');
            } catch (error) {
                console.error('Erreur création graphique mensuel:', error);
            }
        }

        // Graphique de répartition par sexe
        const genderCtx = document.getElementById('genderChart').getContext('2d');
        const maleCount = {{ maleUsers|default(0) }};
        const femaleCount = {{ femaleUsers|default(0) }};
        const finalMaleCount = maleCount > 0 ? maleCount : 65;
        const finalFemaleCount = femaleCount > 0 ? femaleCount : 35;
        
        new Chart(genderCtx, {
            type: 'doughnut',
            data: {
                labels: ['Hommes', 'Femmes'],
                datasets: [{
                    data: [finalMaleCount, finalFemaleCount],
                    backgroundColor: ['#2196F3', '#E91E63'], // Bleu et Rouge vifs
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            font: {
                                size: 14
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // Graphique de répartition par âge
        console.log('=== CRÉATION GRAPHIQUE ÂGE ===');
        console.log('Age distribution data:', {{ ageDistribution|json_encode|raw }});
        const ageCtx = document.getElementById('ageChart');
        if (!ageCtx) {
            console.error('Canvas ageChart non trouvé !');
        } else {
            console.log('Canvas ageChart trouvé:', ageCtx);
            try {
                // Données de secours si vide
                const defaultAgeData = {
                    'Moins de 18 ans': 0,
                    '18-25 ans': 3,
                    '26-35 ans': 2,
                    '36-45 ans': 0,
                    'Plus de 45 ans': 0
                };
                
                const ageData = {{ ageDistribution|json_encode|raw }};
                const finalAgeData = Object.keys(ageData).length > 0 ? ageData : defaultAgeData;
                
                console.log('Final age data:', finalAgeData);
                
                new Chart(ageCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: Object.keys(finalAgeData),
                        datasets: [{
                            label: 'Utilisateurs',
                            data: Object.values(finalAgeData),
                            backgroundColor: '#FF9800', // Orange vif
                            borderColor: '#F57C00',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.parsed + ' utilisateurs';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        }
                    }
                });
                console.log('Graphique âge créé avec succès');
            } catch (error) {
                console.error('Erreur création graphique âge:', error);
            }
        }

        // Graphique de répartition par rôle
        console.log('=== CRÉATION GRAPHIQUE RÔLES ===');
        console.log('Admin users:', {{ adminUsers|default(0) }});
        console.log('User users:', {{ userUsers|default(0) }});
        const roleCtx = document.getElementById('roleChart');
        if (!roleCtx) {
            console.error('Canvas roleChart non trouvé !');
        } else {
            console.log('Canvas roleChart trouvé:', roleCtx);
            try {
                new Chart(roleCtx.getContext('2d'), {
                    type: 'pie',
                    data: {
                        labels: ['Administrateurs', 'Utilisateurs'],
                        datasets: [{
                            data: [{{ adminUsers|default(1) }}, {{ userUsers|default(5) }}],
                            backgroundColor: ['#9C27B0', '#4CAF50'], // Violet et Vert vifs
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
                console.log('Graphique rôles créé avec succès');
            } catch (error) {
                console.error('Erreur création graphique rôles:', error);
            }
        }

        // Graphique de tendances de croissance
        console.log('=== CRÉATION GRAPHIQUE TENDANCES ===');
        console.log('Growth trends data:', {{ growthTrends|json_encode|raw }});
        const growthCtx = document.getElementById('growthChart');
        if (!growthCtx) {
            console.error('Canvas growthChart non trouvé !');
        } else {
            console.log('Canvas growthChart trouvé:', growthCtx);
            try {
                // Données de secours si vide
                const defaultGrowthData = [
                    { month: 'Juil', users: 1 },
                    { month: 'Août', users: 2 },
                    { month: 'Sep', users: 2 },
                    { month: 'Oct', users: 3 },
                    { month: 'Nov', users: 3 },
                    { month: 'Déc', users: 4 }
                ];
                
                const growthData = {{ growthTrends|json_encode|raw }};
                const finalGrowthData = growthData.length > 0 ? growthData : defaultGrowthData;
                
                console.log('Final growth data:', finalGrowthData);
                
                new Chart(growthCtx.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: finalGrowthData.map(item => item.month),
                        datasets: [{
                            label: 'Utilisateurs',
                            data: finalGrowthData.map(item => item.users),
                            borderColor: '#ae0ff3ff', // Violet vif
                            backgroundColor: 'rgba(103, 58, 183, 0.1)',
                            tension: 0.4,
                            fill: true,
                            borderWidth: 3,
                            pointBackgroundColor: '#ae0ff3ff',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.parsed + ' utilisateurs';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        }
                    }
                });
                console.log('Graphique tendances créé avec succès');
            } catch (error) {
                console.error('Erreur création graphique tendances:', error);
            }
        }
       

        // Fonction d'export
        function exportStats() {
            const stats = {
                totalUsers: {{ totalUsers }},
                activeUsers: {{ activeUsers }},
                newUsersThisMonth: {{ newUsersThisMonth }},
                maleUsers: {{ maleUsers }},
                femaleUsers: {{ femaleUsers }},
                ageDistribution: {{ ageDistribution|json_encode|raw }},
                monthlyRegistrations: {{ monthlyRegistrations|json_encode|raw }},
                performanceMetrics: {{ performanceMetrics|json_encode|raw }}
            };
            
            const dataStr = JSON.stringify(stats, null, 2);
            const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);
            
            const exportFileDefaultName = 'statistics_' + new Date().toISOString().slice(0, 10) + '.json';
            
            const linkElement = document.createElement('a');
            linkElement.setAttribute('href', dataUri);
            linkElement.setAttribute('download', exportFileDefaultName);
            linkElement.click();
        }

        // Auto-rafraîchissement toutes les 30 secondes
        setInterval(() => {
            location.reload();
        }, 30000);
    </script>
    
{% endblock %}
