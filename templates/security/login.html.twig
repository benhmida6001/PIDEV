{% extends 'base.html.twig' %}

{% block title %}Connexion - GREENCORE{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Nuages et étoiles animés */
        .stars {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        
        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            animation: twinkle 3s infinite;
        }
        
        @keyframes twinkle {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 1; }
        }
        
        .cloud {
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 100px;
            opacity: 0.4;
        }
        
        .cloud::before {
            content: '';
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 100px;
        }
        
        .cloud::after {
            content: '';
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 100px;
        }
        
        .auth-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            z-index: 10;
            position: relative;
        }
        
        .form-control {
            background-color: #e8f5e8;
            border: 2px solid #4caf50;
            color: #2e7d32;
            font-weight: 500;
            padding: 12px 15px;
            border-radius: 8px;
        }
        
        .form-control:focus {
            background-color: #c8e6c9;
            border-color: #388e3c;
            box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
            color: #1b5e20;
        }
        
        .form-control::placeholder {
            color: #81c784;
        }
        
        .form-label {
            color: #2e7d32;
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .btn-primary {
            background-color: #4caf50;
            border-color: #4caf50;
            font-weight: 600;
            padding: 12px 30px;
            border-radius: 8px;
        }
        
        .btn-primary:hover {
            background-color: #388e3c;
            border-color: #388e3c;
        }
        
        .welcome-text {
            color: white;
            font-size: 2.5rem;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 2rem;
        }
        
        .login-title {
            color: #2e7d32;
            font-weight: bold;
            margin-bottom: 1.5rem;
        }
        
        .text-link {
            color: #388e3c;
            text-decoration: none;
            font-weight: 500;
        }
        
        .text-link:hover {
            color: #1b5e20;
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    {% block navbar %}{% endblock %}
    
    <!-- Étoiles animées -->
    <div class="stars">
        <div class="star" style="width: 2px; height: 2px; top: 10%; left: 20%; animation-delay: 0s;"></div>
        <div class="star" style="width: 3px; height: 3px; top: 15%; left: 80%; animation-delay: 0.5s;"></div>
        <div class="star" style="width: 2px; height: 2px; top: 25%; left: 60%; animation-delay: 1s;"></div>
        <div class="star" style="width: 1px; height: 1px; top: 35%; left: 30%; animation-delay: 1.5s;"></div>
        <div class="star" style="width: 2px; height: 2px; top: 45%; left: 70%; animation-delay: 2s;"></div>
        <div class="star" style="width: 3px; height: 3px; top: 55%; left: 25%; animation-delay: 2.5s;"></div>
        <div class="star" style="width: 1px; height: 1px; top: 65%; left: 85%; animation-delay: 0.3s;"></div>
        <div class="star" style="width: 2px; height: 2px; top: 75%; left: 40%; animation-delay: 0.8s;"></div>
        <div class="star" style="width: 2px; height: 2px; top: 85%; left: 65%; animation-delay: 1.3s;"></div>
        <div class="star" style="width: 3px; height: 3px; top: 90%; left: 15%; animation-delay: 1.8s;"></div>
    </div>
    
    <!-- Nuages -->
    <div class="cloud" style="width: 100px; height: 40px; top: 20%; left: 10%; animation: float 20s infinite;"></div>
    <div class="cloud" style="width: 80px; height: 35px; top: 40%; left: 70%; animation: float 25s infinite;"></div>
    <div class="cloud" style="width: 120px; height: 45px; top: 60%; left: 20%; animation: float 30s infinite;"></div>
    
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-6 col-lg-4">
            <div class="auth-container p-5">
                <div class="text-center mb-4">
                    <div class="welcome-text">GREENCORE</div>
                    <h2 class="h4 login-title">USER LOGIN</h2>
                </div>

                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" id="loginForm" onsubmit="console.log('Formulaire soumis'); return true;">
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">Email</label>
                        <input type="email" value="{{ last_username|default('') }}" name="_username" id="inputEmail" 
                               class="form-control" autocomplete="email" required autofocus
                               placeholder="Entrez votre email">
                    </div>

                    <div class="mb-4">
                        <label for="inputPassword" class="form-label">Password</label>
                        <input type="password" name="_password" id="inputPassword" 
                               class="form-control" autocomplete="current-password" required
                               placeholder="Entrez votre mot de passe">
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Sign In
                        </button>
                    </div>
                    <div class="text-center">
                        <div class="mb-2">
                          <a href="#" class="text-link">
                                Become a member
                            </a>
                        </div>
                        <div>
                         <a href="{{ path('app_reset_password_request') }}" class="text-link">
                                Forgot password
                            </a>
                        </div>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <div class="mb-2">
                        <a href="{{ path('app_home') }}" class="text-link">
                             Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        @keyframes float {
            0%, 100% { transform: translateX(0) translateY(0); }
            25% { transform: translateX(20px) translateY(-10px); }
            50% { transform: translateX(-10px) translateY(5px); }
            75% { transform: translateX(15px) translateY(-5px); }
        }
    </style>
{% endblock %}
