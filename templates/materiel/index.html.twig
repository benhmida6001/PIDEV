<script>
function saveImagePreview(event) {
    const fileInput = event.target.querySelector('input[name="returned_image"]');
    const file = fileInput.files[0];
    
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            localStorage.setItem('returnedImagePreview', e.target.result);
        };
        reader.readAsDataURL(file);
    }
}
</script>
