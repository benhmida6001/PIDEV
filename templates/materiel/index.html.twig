{% extends 'base.html.twig' %}

{% block title %}Materials{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Materials</h1>
        <a href="{{ path('app_materiel_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Material
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Available Qty</th>
                            <th>Total Qty</th>
                            <th>Owner</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for materiel in materiels %}
                        <tr>
                            <td>
                                {% if materiel.image %}
                                    <img src="{{ asset('uploads/' ~ materiel.image) }}" alt="{{ materiel.name }}" 
                                         class="img-thumbnail" style="max-width: 60px; max-height: 60px; object-fit: cover;">
                                {% else %}
                                    <span class="badge bg-secondary">No image</span>
                                {% endif %}
                            </td>
                            <td><strong>{{ materiel.name }}</strong></td>
                            <td>
                                <span class="badge bg-info">
                                    {{ materiel.category ? materiel.category.name : 'N/A' }}
                                </span>
                            </td>
                            <td>
                                {% set statusClass = {
                                    'excellent': 'success',
                                    'good': 'primary',
                                    'acceptable': 'warning',
                                    'to_check': 'danger'
                                } %}
                                <span class="badge bg-{{ statusClass[materiel.status] ?? 'secondary' }}">
                                    {{ materiel.status|replace({'_': ' '})|title }}
                                </span>
                            </td>
                            <td><strong>{{ materiel.availableQuantity }}</strong></td>
                            <td>{{ materiel.quantity }}</td>
                            <td>
                                <small>{{ materiel.owner ? materiel.owner.email : 'N/A' }}</small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('app_materiel_show', {'id': materiel.id}) }}" 
                                       class="btn btn-info" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_materiel_edit', {'id': materiel.id}) }}" 
                                       class="btn btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted">
                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                <p class="mb-0">No materials found</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}