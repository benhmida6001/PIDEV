{# templates/categorie/_delete_form.html.twig #}

<form method="post" action="{{ path('app_categorie_delete', {'id_categorie': categorie.idCategorie}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet élément ?');">
    
    {# ATTENTION ICI : On utilise idCategorie pour le token #}
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.idCategorie) }}">
    
    <button class="btn btn-danger">Delete</button>
</form>