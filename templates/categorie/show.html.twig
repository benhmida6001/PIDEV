{% extends 'sc.html.twig' %}

{% block title %}Categorie{% endblock %}

{% block body %}
    <h1>Categorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_categorie</th>
                {# 1. Ici c'est bon : CamelCase #}
                <td>{{ categorie.idCategorie }}</td>
            </tr>
            <tr>
                <th>Nom_categorie</th>
                <td>{{ categorie.nomCategorie }}</td>
            </tr>
            <tr>
                <th>Instruction_tri</th>
                <td>{{ categorie.instructionTri }}</td>
            </tr>
            <tr>
                <th>Score_priorite</th>
                <td>{{ categorie.scorePriorite }}</td>
            </tr>
            <tr>
                <th>Temps_decomposition</th>
                <td>{{ categorie.tempsDecomposition }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_categorie_index') }}">back to list</a>

    {# 2. C'EST ICI QU'IL FALLAIT CORRIGER : #}
    {# Clé (URL) : 'id_categorie' (avec tiret) #}
    {# Valeur (PHP) : categorie.idCategorie (sans tiret, avec C majuscule) #}
    
    <a href="{{ path('app_categorie_edit', {'id_categorie': categorie.idCategorie}) }}">edit</a>

    {{ include('categorie/_delete_form.html.twig') }}
{% endblock %}