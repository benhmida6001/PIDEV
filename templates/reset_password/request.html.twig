{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe - {{ 'app.name'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: linear-gradient(180deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%);
            min-height: 100vh;
        }

        .center-wrap{
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .reset-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            max-width: 500px;
            width: 100%;
        }

        .reset-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .reset-header h1 {
            color: #1b5e20;
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .reset-header p {
            color: #666;
            margin-bottom: 0;
        }

        .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 12px 15px;
            width: 100%;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #1b5e20;
            box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.1);
            outline: none;
        }

        .form-label {
            color: #333;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .btn-reset {
            background: linear-gradient(45deg, #1b5e20, #2e7d32);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            display: block;
        }

        .btn-reset:hover {
            background: linear-gradient(45deg, #2e7d32, #43a047);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(27, 94, 32, 0.3);
        }

        .back-link {
            display: block;
            text-align: center;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 20px;
            padding: 15px;
        }

        .alert-success {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
        }

        .alert-danger {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
        }

        .alert-info {
            background-color: #d1ecf1;
            border: 1px solid #bee5eb;
            color: #0c5460;
        }

        /* Thème Sombre */
        body.dark-theme {
          background: linear-gradient(180deg, #1a202c 0%, #2d3748 50%, #4a5568 100%) !important;
        }

        body.dark-theme .reset-card {
            background: rgba(30, 41, 59, 0.95);
            color: #fff;
        }

        body.dark-theme .reset-header h1 {
            color: #fff;
        }

        body.dark-theme .reset-header p {
            color: #b0b0b0;
        }

        body.dark-theme .form-control {
            background: rgba(255, 255, 255, 0.1);
            border-color: #4a5568;
            color: #fff;
        }

        body.dark-theme .form-control:focus {
            border-color: #64b5f6;
            box-shadow: 0 0 0 3px rgba(100, 181, 246, 0.1);
        }

        body.dark-theme .form-label {
            color: #e0e0e0;
        }

        body.dark-theme .btn-reset {
            background: linear-gradient(45deg, #3949ab, #5e35b1);
        }

        body.dark-theme .btn-reset:hover {
            background: linear-gradient(45deg, #5e35b1, #7e57c2);
        }

        body.dark-theme .back-link {
            color: #64b5f6;
        }

        /* Thème Clair */
        body.light-theme {
            background: linear-gradient(180deg, #e3f2fd 0%, #bbdefb 50%, #90caf9 100%);
        }

        body.light-theme .reset-card {
            background: rgba(255, 255, 255, 0.98);
            color: #333;
        }

        body.light-theme .reset-header h1 {
            color: #1565c0;
        }

        body.light-theme .form-control {
            border-color: #90caf9;
            background: rgba(255, 255, 255, 0.8);
        }

        body.light-theme .form-control:focus {
            border-color: #42a5f5;
            box-shadow: 0 0 0 3px rgba(66, 165, 245, 0.1);
        }

        body.light-theme .btn-reset {
            background: linear-gradient(45deg, #42a5f5, #2196f3);
        }

        body.light-theme .btn-reset:hover {
            background: linear-gradient(45deg, #2196f3, #1976d2);
        }

        body.light-theme .back-link {
            color: #1976d2;
        }

        /* Thème par défaut (vert) */
        body.default-theme {
            background: linear-gradient(180deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%);
        }

        body.default-theme .reset-card {
            background: rgba(255, 255, 255, 0.95);
            color: #333;
        }

        body.default-theme .reset-header h1 {
            color: #1b5e20;
        }

        body.default-theme .btn-reset {
            background: linear-gradient(45deg, #1b5e20, #2e7d32);
        }

        body.default-theme .btn-reset:hover {
            background: linear-gradient(45deg, #2e7d32, #43a047);
        }

        body.default-theme .back-link {
            color: #2e7d32;
        }
    </style>
{% endblock %}

{% block body %}
{% set current_theme = app.session.get('theme', 'default') %}
<body class="{{ current_theme }}-theme">
<div class="center-wrap">
    <div class="reset-card">
        <div class="reset-header">
            <h1>Forgot password</h1>
            <p>Entrez votre adresse email pour recevoir un lien</p>
        </div>

        {# messages flash #}
        {% for flash in app.flashes('success') %}
            <div class="alert alert-success">{{ flash }}</div>
        {% endfor %}
        {% for flash in app.flashes('error') %}
            <div class="alert alert-danger">{{ flash }}</div>
        {% endfor %}
        {% for flash in app.flashes('info') %}
            <div class="alert alert-info">{{ flash }}</div>
        {% endfor %}

        {# erreurs globales du formulaire #}
        {{ form_errors(requestForm) }}

        {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-3">
                {{ form_label(requestForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(requestForm.email, {'attr': {'class': 'form-control','placeholder':'example@esprit.tn'}}) }}
                {{ form_errors(requestForm.email) }}
            </div>
            <div class="mb-3">
                {{ form_widget(requestForm.submit, {'attr': {'class': 'btn btn-primary'}}) }}
            </div>
        {{ form_end(requestForm) }}

        <a href="{{ path('app_login') }}" class="btn btn-secondary">
            Retour
        </a>
    </div>
</div>
</body>
{% endblock %}
