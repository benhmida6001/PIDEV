{% extends 'base.html.twig' %}

{% block title %}Accueil - GREENCORE{% endblock %}

{% block body %}
    {% if app.user %}
        <div class="text-center">
            <div class="card">
                <div class="card-body">
                    <h1 class="text-primary" style="color: #4caf50 !important;">🌍 Bienvenue sur GREENCORE</h1>
                    <p>La Technologie au coeur de la planète</p>
                    <p class="text-muted">Bonjour {{ app.user.email }} </p>
                    
                    <div class="mt-4">
                        <a href="{{ path('app_profile') }}" class="btn btn-primary me-2">
                             Voir mon profil
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_users') }}" class="btn btn-danger me-2">
                                 Administration
                            </a>
                        {% endif %}
                        <a href="{{ path('app_logout') }}" class="btn btn-secondary">
                             Déconnexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-8 text-center">
                <div class="auth-container p-5">
                    <div class="logo mb-4">🌍 GREENCORE</div>
                    <h1 style="color: #4caf50 !important;">LA TECHNOLOGIE AU CŒUR DE LA PLANÈTE</h1>
                    <p class="lead mb-4">
                        Bienvenue sur notre plateforme innovante pour une gestion durable et intelligente.
                    </p>
                    
                    <div class="row mt-5">
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h3 class="text-primary" style="color: #4caf50 !important;"> Connexion</h3>
                                    <p class="text-muted">Accédez à votre espace personnel</p>
                                    <a href="{{ path('app_login') }}" class="btn btn-primary">
                                        Se connecter
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h3 class="text-success" style="color: #66bb6a !important;">Inscription</h3>
                                    <p class="text-muted">Créez votre compte gratuitement</p>
                                    <a href="{{ path('app_register') }}" class="btn btn-success">
                                        S'inscrire
                                    </a>
                                  
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-center mt-4">
                        <small class="text-muted">
                            Réalisé par Warriors
                        </small>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
